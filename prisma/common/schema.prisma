generator client {
  provider      = "prisma-client-js"
  output        = "../../node_modules/@prisma/common/client"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
  engineType    = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("COMMON_DATABASE_URL")
  directUrl = env("COMMON_DATABASE_URL_UNPOOLED")
}

model Tenant {
  id                 Int                 @id @default(autoincrement())
  tenantId           String              @unique
  ownerId            Int
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  isActive           Boolean             @default(true)
  Organizations      Organization[]
  Owner              User                @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  TenantSetting      TenantSetting?
  UserDefaultTenants UserDefaultTenant[]
}

model TenantSetting {
  id                      Int     @id @default(autoincrement())
  tenantId                Int     @unique
  onPremise               Boolean @default(false)
  storageConnectionString String?
  dbConnectionString      String?
  Tenant                  Tenant  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model User {
  id                               Int                           @id @default(autoincrement())
  userId                           String                        @unique
  email                            String                        @unique
  picture                          String?
  createdAt                        DateTime                      @default(now())
  deletedAt                        DateTime?
  isActive                         Boolean                       @default(true)
  updatedAt                        DateTime                      @default(now()) @updatedAt
  bloodType                        BloodType?
  civilStatus                      CivilStatus?
  dob                              DateTime?                     @db.Date
  firstName                        String?
  gender                           Gender?
  lastName                         String?
  middleName                       String?
  mobile                           String?
  nationality                      String?
  nickname                         String?
  religion                         String?
  suffix                           String?
  telephone                        String?
  ActivationCodes                  ActivationCode[]
  Folders                          Folder[]
  HealthcareProvider               HealthcareProvider?
  ReceiptCodeClaims                ReceiptCodeClaim[]
  SocialLink                       SocialLink?
  Tenants                          Tenant[]
  UserAddresses                    UserAddress[]
  UserAllergies                    UserAllergy[]
  UserDefaultOrganization          UserDefaultOrganization?
  UserDefaultOrganizationRoles     UserDefaultOrganizationRole[]
  UserDefaultTenant                UserDefaultTenant?
  DiagnosedUserDisabilities        UserDisability[]              @relation("DiagnosedUserDisability")
  UserDisabilities                 UserDisability[]              @relation("UserDisability")
  UserEmergencyContacts            UserEmergencyContact[]
  UserEmployments                  UserEmploymentRecord[]
  DiagnosedUserHealthConditions    UserHealthCondition[]         @relation("DiagnosedUserHealthCondition")
  ResolvedUserHealthConditions     UserHealthCondition[]         @relation("ResolvedUserHealthCondition")
  UserHealthConditions             UserHealthCondition[]         @relation("HealthCondition")
  UserMigration                    UserMigration?
  AcceptedOrganizationApplications UserOrganization[]            @relation("AcceptedBy")
  Organizations                    UserOrganization[]            @relation("User")
  Plans                            UserPlan[]
  StudentRecords                   UserStudentRecord[]
  UserVaccinations                 UserVaccination[]
  VitalSigns                       VitalSign[]
  UserSchedules                    UserSchedule[]
  UserPermissions                  UserPermission[]
  OrgUserPermissions               OrgUserPermission[]
}

model Organization {
  id                           Int                           @id @default(autoincrement())
  tenantId                     Int
  orgId                        String                        @unique
  name                         String
  description                  String?
  picture                      String?
  cover                        String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  deletedAt                    DateTime?
  isActive                     Boolean                       @default(true)
  customUrl                    String?
  email                        String?
  FileTypeAttributes           FileTypeAttribute[]
  ScopeFolders                 FolderSetting[]
  OrgYearLevels                OrgYearLevel[]
  Tenant                       Tenant                        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Colleges                     OrganizationCollege[]
  Departments                  OrganizationDepartment[]
  Offices                      OrganizationOffice[]
  Programs                     OrganizationProgram[]
  OrganizationSetting          OrganizationSetting?
  UserDefaultOrganizations     UserDefaultOrganization[]
  UserDefaultOrganizationRoles UserDefaultOrganizationRole[]
  UserEmployments              UserEmploymentRecord[]
  UserMigrations               UserMigration[]
  Users                        UserOrganization[]
  Roles                        UserOrganizationRole[]
  UserStudentRecords           UserStudentRecord[]
  OrgAppointmentConfig         OrgAppointmentConfig?
  OrgUserPermissions           OrgUserPermission[]
  OrgAppointmentTabs           OrgAppointmentTab[]
  OrgConsultationConfig        OrgConsultationConfig?
}

model OrganizationSetting {
  id                    Int          @id @default(autoincrement())
  orgId                 Int          @unique
  isPublic              Boolean      @default(false)
  sendEmailNotification Boolean      @default(true)
  emailToOrgOnly        Boolean      @default(false)
  enableAppointment     Boolean      @default(true)
  enableConsultation    Boolean      @default(true)
  Organization          Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model OrgAppointmentConfig {
  id                         Int          @id @default(autoincrement())
  orgId                      Int          @unique
  maxAppointmentsPerClient   Int          @default(0)
  lastPerClientIntervalReses DateTime?    @db.Date
  perClientResetInterval     Int          @default(0)
  maxAppointmentsPerDay      Int          @default(0)
  lastPerDayIntervalReset    DateTime?    @db.Date
  perDayResetInterval        Int          @default(0)
  Organization               Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model OrgConsultationConfig {
  id             Int          @id @default(autoincrement())
  orgId          Int          @unique
  NoteTemplateId Int
  NoteTemplate   NoteTemplate @relation(fields: [NoteTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Organization   Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model NoteTemplate {
  id                     Int                     @id @default(autoincrement())
  name                   String                  @unique
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  isActive               Boolean                 @default(true)
  NoteSections           NoteSection[]
  OrgConsultationConfigs OrgConsultationConfig[]
}

model NoteSection {
  id             Int          @id @default(autoincrement())
  noteTemplateId Int
  name           String
  description    String?
  isActive       Boolean      @default(true)
  NoteTemplate   NoteTemplate @relation(fields: [noteTemplateId], references: [id])

  @@unique([noteTemplateId, name], name: "unique_note_section")
}

model OrgAppointmentTab {
  id                     Int                     @id @default(autoincrement())
  orgId                  Int
  appointmentTabId       Int
  Organization           Organization            @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  AppointmentTab         AppointmentTab          @relation(fields: [appointmentTabId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OrgRoleAppointmentTabs OrgRoleAppointmentTab[]

  @@unique([orgId, appointmentTabId], name: "unique_org_appointment_tab")
}

model OrgRoleAppointmentTab {
  id                  Int                  @id @default(autoincrement())
  orgRoleId           Int
  orgAppointmentTabId Int
  Role                UserOrganizationRole @relation(fields: [orgRoleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OrgAppointmentTab   OrgAppointmentTab    @relation(fields: [orgAppointmentTabId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([orgRoleId, orgAppointmentTabId], name: "unique_role_appointment_tab")
}

model AppointmentTab {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  description        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  isActive           Boolean             @default(true)
  OrgAppointmentTabs OrgAppointmentTab[]
}

model OrgUserPermission {
  id           Int          @id @default(autoincrement())
  orgId        Int
  userId       Int
  permissionId Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  Organization Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User         User         @relation(fields: [userId], references: [id])

  @@unique([orgId, userId, permissionId], name: "unique_org_user_permission")
}

model UserPermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  isActive     Boolean    @default(true)
  User         User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Permission   Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Permission {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique
  description        String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  isActive           Boolean             @default(true)
  OrgUserPermissions OrgUserPermission[]
  UserPermissions    UserPermission[]
}

model UserOrganization {
  id             Int                    @id @default(autoincrement())
  userId         Int
  organizationId Int
  acceptedAt     DateTime?              @db.Date
  acceptedBy     Int?
  createdAt      DateTime               @default(now())
  status         UserOrganizationStatus @default(PENDING)
  role           Int
  AcceptedBy     User?                  @relation("AcceptedBy", fields: [acceptedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  UserRole       UserOrganizationRole   @relation(fields: [role], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User           User                   @relation("User", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, organizationId, role], name: "unique_user_organization_role")
}

model UserOrganizationRole {
  id                           Int                           @id @default(autoincrement())
  orgId                        Int
  name                         String
  description                  String?
  isActive                     Boolean                       @default(true)
  requirements                 String[]                      @default([])
  UserDefaultOrganizationRoles UserDefaultOrganizationRole[]
  UserEmploymentRecord         UserEmploymentRecord[]
  UserOrganizations            UserOrganization[]
  Organization                 Organization                  @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  UserStudentRecords           UserStudentRecord[]
  OrgRoleAppointmentTabs       OrgRoleAppointmentTab[]

  @@unique([orgId, name], name: "unique_organization_role")
}

model Plan {
  id          Int        @id @default(autoincrement())
  planUid     String     @unique
  price       Float
  name        String
  type        PlanType
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  isActive    Boolean    @default(true)
  Features    Feature[]
  Users       UserPlan[]
}

model Feature {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  planId      Int
  Plan        Plan      @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model UserPlan {
  id        Int            @id @default(autoincrement())
  userId    Int
  planId    Int
  startDate DateTime
  endDate   DateTime
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  isActive  Boolean        @default(true)
  status    UserPlanStatus
  Plan      Plan           @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User      User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model HealthcareProvider {
  id                  Int                    @id @default(autoincrement())
  userId              Int                    @unique
  type                HealthcareProviderType
  description         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime?
  isActive            Boolean                @default(true)
  isPublished         Boolean                @default(false)
  DoctorProfile       DoctorProfile?
  User                User                   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  NurseProfile        NurseProfile?
  ProfessionalDetails ProfessionalDetails?
}

model DoctorProfile {
  id                   Int                @id @default(autoincrement())
  healthcareProviderId Int                @unique
  title                String
  name                 String
  suffix               String?
  picture              String?
  cover                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  isActive             Boolean            @default(true)
  affiliations         String[]           @default([])
  areaOfInterest       String?
  certifications       String[]           @default([])
  experience           String?
  fields               String[]           @default([])
  hobbies              String?
  languages            String[]           @default([])
  philosophy           String?
  specialties          String[]           @default([])
  workEmail            String?
  workPhone            String?
  educations           String[]           @default([])
  HealthcareProvider   HealthcareProvider @relation(fields: [healthcareProviderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model NurseProfile {
  id                   Int                @id @default(autoincrement())
  healthcareProviderId Int                @unique
  title                String
  name                 String
  suffix               String?
  picture              String?
  cover                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  isActive             Boolean            @default(true)
  affiliations         String[]           @default([])
  areaOfInterest       String?
  certifications       String[]           @default([])
  experience           String?
  fields               String[]           @default([])
  hobbies              String?
  languages            String[]           @default([])
  philosophy           String?
  specialties          String[]           @default([])
  workEmail            String?
  workPhone            String?
  educations           String[]           @default([])
  HealthcareProvider   HealthcareProvider @relation(fields: [healthcareProviderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ProfessionalDetails {
  id                 Int                @id @default(autoincrement())
  healthcareProverId Int                @unique
  licenseNumber      String
  licenseIssued      DateTime
  licenseExpires     DateTime
  ptrNumber          String
  taxNumber          String
  HealthCareProvider HealthcareProvider @relation(fields: [healthcareProverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model UserDefaultOrganization {
  id             Int          @id @default(autoincrement())
  userId         Int          @unique
  organizationId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  isActive       Boolean      @default(true)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User           User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model UserDefaultOrganizationRole {
  id             Int                  @id @default(autoincrement())
  userId         Int
  organizationId Int
  roleId         Int
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deletedAt      DateTime?
  isActive       Boolean              @default(true)
  Organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  UserRole       UserOrganizationRole @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User           User                 @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, organizationId, roleId], name: "unique_user_organization_role")
}

model UserDefaultTenant {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  tenantId  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)
  Tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model SocialLink {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  facebook  String?
  instagram String?
  linkedin  String?
  tiktok    String?
  twitter   String?
  website   String?
  User      User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ReceiptCode {
  id                Int                @id @default(autoincrement())
  coverage          Coverage
  code              String             @unique
  amount            Float
  status            ReceiptCodeStatus  @default(UNUSED)
  maxUses           Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  isActive          Boolean            @default(true)
  ReceiptCodeClaims ReceiptCodeClaim[]
}

model ReceiptCodeClaim {
  id            Int         @id @default(autoincrement())
  userId        Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  isActive      Boolean     @default(true)
  receiptCodeId Int
  ReceiptCode   ReceiptCode @relation(fields: [receiptCodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User          User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, receiptCodeId], name: "unique_user_receipt_code")
}

model UserMigration {
  id           Int          @id @default(autoincrement())
  userId       Int          @unique
  orgId        Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  isActive     Boolean      @default(true)
  Organization Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User         User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, orgId], name: "unique_user_migration")
}

model ActivationCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  userId    Int
  expiresAt DateTime
  isUsed    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)
  User      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Folder {
  id            Int            @id @default(autoincrement())
  userId        Int
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  isActive      Boolean        @default(true)
  Files         File[]
  User          User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  FolderSetting FolderSetting?

  @@unique([userId, name], name: "unique_user_folder")
}

model FolderSetting {
  id           Int           @id @default(autoincrement())
  folderId     Int           @unique
  scopeOrgId   Int?
  isPublic     Boolean       @default(false)
  Folder       Folder        @relation(fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Organization Organization? @relation(fields: [scopeOrgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model File {
  id          Int          @id @default(autoincrement())
  folderId    Int
  fileTypeId  Int
  name        String
  size        Int
  url         String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  isActive    Boolean      @default(true)
  dateTaken   DateTime?
  FileType    FileType     @relation(fields: [fileTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Folder      Folder       @relation(fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  FileSetting FileSetting?

  @@unique([folderId, name], name: "unique_folder_file")
}

model FileSetting {
  id       Int     @id @default(autoincrement())
  fileId   Int     @unique
  isPublic Boolean @default(false)
  File     File    @relation(fields: [fileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model FileType {
  id                Int                @id @default(autoincrement())
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  isActive          Boolean            @default(true)
  Files             File[]
  FileTypeAttribute FileTypeAttribute?
}

model FileTypeAttribute {
  id                Int           @id @default(autoincrement())
  fileTypeId        Int           @unique
  required          Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?
  isActive          Boolean       @default(true)
  scopeOrgId        Int?
  validUntil        Int           @default(0)
  dateTakenRequired Boolean       @default(true)
  FileType          FileType      @relation(fields: [fileTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Organization      Organization? @relation(fields: [scopeOrgId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([fileTypeId, scopeOrgId], name: "unique_file_type_attribute")
}

model UserEmergencyContact {
  id           Int       @id @default(autoincrement())
  userId       Int
  isPrimary    Boolean   @default(true)
  name         String
  relationship String
  phone        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  isActive     Boolean   @default(true)
  address      String?
  User         User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model UserAddress {
  id        Int       @id @default(autoincrement())
  userId    Int
  isPrimary Boolean   @default(true)
  address   String
  city      String
  state     String
  zipCode   String
  country   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)
  User      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Vaccine {
  id               Int               @id @default(autoincrement())
  name             String
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  isActive         Boolean           @default(true)
  type             String
  UserVaccinations UserVaccination[]
  VaccineAttribute VaccineAttribute?
  VaccineDoses     VaccineDose[]
  VaccineRoutes    VaccineRoute[]
}

model VaccineAttribute {
  id          Int     @id @default(autoincrement())
  vaccineId   Int     @unique
  effectivity Int
  Vaccine     Vaccine @relation(fields: [vaccineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Route {
  id               Int               @id @default(autoincrement())
  route            String
  description      String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  UserVaccinations UserVaccination[]
  VaccineRoutes    VaccineRoute[]
}

model Dose {
  id               Int               @id @default(autoincrement())
  dose             String
  description      String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  UserVaccinations UserVaccination[]
  VaccineDoses     VaccineDose[]
}

model VaccineRoute {
  id        Int     @id @default(autoincrement())
  vaccineId Int
  routeId   Int
  Route     Route   @relation(fields: [routeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Vaccine   Vaccine @relation(fields: [vaccineId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vaccineId, routeId], name: "unique_vaccine_route")
}

model VaccineDose {
  id        Int     @id @default(autoincrement())
  vaccineId Int
  doseId    Int
  Dose      Dose    @relation(fields: [doseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Vaccine   Vaccine @relation(fields: [vaccineId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vaccineId, doseId], name: "unique_vaccine_dose")
}

model UserVaccination {
  id             Int       @id @default(autoincrement())
  userId         Int
  vaccineId      Int
  doseId         Int
  routeId        Int
  dateGiven      DateTime
  notes          String?
  administeredBy String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  isActive       Boolean   @default(true)
  Dose           Dose      @relation(fields: [doseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Route          Route     @relation(fields: [routeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User           User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Vaccine        Vaccine   @relation(fields: [vaccineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Allergen {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  isActive      Boolean       @default(true)
  UserAllergies UserAllergy[]
}

model UserAllergy {
  id         Int      @id @default(autoincrement())
  userId     Int
  reaction   String
  notes      String?
  allergenId Int
  Allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User       User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, allergenId], name: "unique_user_allergy")
}

model HealthCondition {
  id                   Int                   @id @default(autoincrement())
  name                 String                @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  isActive             Boolean               @default(true)
  UserHealthConditions UserHealthCondition[] @relation("UserHealthCondition")
}

model UserHealthCondition {
  id                Int                    @id @default(autoincrement())
  userId            Int
  healthConditionId Int
  dateDiagnosed     DateTime?
  severity          Severity
  notes             String?
  dateResolved      DateTime?
  diagnosedBy       Int?
  resolvedBy        Int?
  status            HealthConditionStatus? @default(UNRESOLVED)
  DiagnosedBy       User?                  @relation("DiagnosedUserHealthCondition", fields: [diagnosedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  HealthCondition   HealthCondition        @relation("UserHealthCondition", fields: [healthConditionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ResolvedBy        User?                  @relation("ResolvedUserHealthCondition", fields: [resolvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User              User                   @relation("HealthCondition", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, healthConditionId], name: "unique_user_health_condition")
}

model Disability {
  id               Int              @id @default(autoincrement())
  name             String           @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  isActive         Boolean          @default(true)
  UserDisabilities UserDisability[]
}

model UserDisability {
  id            Int        @id @default(autoincrement())
  userId        Int
  disabilityId  Int
  dateDiagnosed DateTime?
  severity      Severity
  notes         String?
  isManaged     Boolean?   @default(false)
  reason        String?
  diagnosedBy   Int?
  DiagnosedBy   User?      @relation("DiagnosedUserDisability", fields: [diagnosedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Disability    Disability @relation(fields: [disabilityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User          User       @relation("UserDisability", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, disabilityId], name: "unique_user_disability")
}

model VitalSign {
  id          Int       @id @default(autoincrement())
  userId      Int
  dateTaken   DateTime
  height      Float?
  weight      Float?
  bmi         Float?
  bpSystolic  Int?
  bpDiastolic Int?
  pulseRate   Int?
  temp        Float?
  spo2        Float?
  respRate    Int?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  User        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model OrganizationDepartment {
  id                    Int                    @id @default(autoincrement())
  organizationId        Int
  name                  String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  isActive              Boolean                @default(true)
  Organization          Organization           @relation(fields: [organizationId], references: [id])
  UserEmploymentRecords UserEmploymentRecord[]
  StudentRecords        UserStudentRecord[]
}

model OrganizationProgram {
  id             Int                 @id @default(autoincrement())
  organizationId Int
  name           String
  description    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  isActive       Boolean             @default(true)
  Organization   Organization        @relation(fields: [organizationId], references: [id])
  StudentRecords UserStudentRecord[]
}

model OrganizationCollege {
  id                    Int                    @id @default(autoincrement())
  organizationId        Int
  name                  String
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  isActive              Boolean                @default(true)
  Organization          Organization           @relation(fields: [organizationId], references: [id])
  UserEmploymentRecords UserEmploymentRecord[]
  UserStudentRecords    UserStudentRecord[]
}

model StudentLevel {
  id             Int                 @id @default(autoincrement())
  name           String              @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  isActive       Boolean             @default(true)
  StudentRecords UserStudentRecord[]
}

model OrgYearLevel {
  id                 Int                 @id @default(autoincrement())
  organizationId     Int
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  isActive           Boolean             @default(true)
  Organization       Organization        @relation(fields: [organizationId], references: [id])
  UserStudentRecords UserStudentRecord[]
}

model UserStudentRecord {
  id                     Int                     @id @default(autoincrement())
  userId                 Int
  organizationId         Int
  studentId              String                  @unique
  lrn                    String?                 @unique
  level                  Int
  yearLevel              Int?
  programId              Int?
  departmentId           Int?
  collegeId              Int?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  isActive               Boolean                 @default(true)
  userOrganizationRoleId Int?
  College                OrganizationCollege?    @relation(fields: [collegeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Department             OrganizationDepartment? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Level                  StudentLevel            @relation(fields: [level], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Program                OrganizationProgram?    @relation(fields: [programId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User                   User                    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  UserOrganizationRole   UserOrganizationRole?   @relation(fields: [userOrganizationRoleId], references: [id])
  YearLevel              OrgYearLevel?           @relation(fields: [yearLevel], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, organizationId], name: "unique_user_student_record")
}

model OrganizationOffice {
  id                    Int                    @id @default(autoincrement())
  organizationId        Int
  name                  String
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  isActive              Boolean                @default(true)
  Organization          Organization           @relation(fields: [organizationId], references: [id])
  UserEmploymentRecords UserEmploymentRecord[]
}

model UserEmploymentRecord {
  id                     Int                     @id @default(autoincrement())
  userId                 Int
  organizationId         Int
  employeeId             String                  @unique
  position               String
  designation            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  isActive               Boolean                 @default(true)
  collegeId              Int?
  departmentId           Int?
  officeId               Int?
  userOrganizationRoleId Int?
  College                OrganizationCollege?    @relation(fields: [collegeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Department             OrganizationDepartment? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Office                 OrganizationOffice?     @relation(fields: [officeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User                   User                    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  UserOrganizationRole   UserOrganizationRole?   @relation(fields: [userOrganizationRoleId], references: [id])

  @@unique([userId, organizationId], name: "unique_user_employment")
}

