model AIUsageSummary {
  id                 Int      @id @default(autoincrement())
  clinicId           Int?
  tenantId           Int?
  period             String
  totalRequests      Int      @default(0)
  totalTokens        Int      @default(0)
  totalCostUSD       Float    @default(0)
  successfulRequests Int      @default(0)
  failedRequests     Int      @default(0)
  lastUpdated        DateTime
  createdAt          DateTime @default(now())
  Clinic             Clinic?  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  Tenant             Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([clinicId, period])
  @@unique([tenantId, period])
}

model GlobalAIDefaults {
  id                 Int      @id @unique @default(autoincrement())
  defaultMaxRequests Int      @default(1000)
  defaultMaxTokens   Int?
  defaultMaxCostUSD  Float?
  defaultResetDay    Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model OnboardingStep {
  id          Int                  @id @default(autoincrement())
  userId      Int
  entityType  OnboardingEntityType @default(USER)
  entityId    Int?
  stepName    String
  stepLabel   String?
  status      OnboardingStepStatus @default(PENDING)
  isRequired  Boolean              @default(true)
  completedAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  User        User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, entityType, entityId, stepName], name: "unique_onboarding_step")
  @@index([userId])
  @@index([entityType, entityId])
  @@index([status])
}

model OnboardingStepLog {
  id             Int                  @id @default(autoincrement())
  userId         Int
  entityType     OnboardingEntityType @default(USER)
  entityId       Int?
  action         String
  stepName       String?
  previousStatus String?
  newStatus      String?
  metadata       String?
  performedBy    Int?
  createdAt      DateTime             @default(now())
  User           User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model OrgOnboardingRequirement {
  id             Int                  @id @default(autoincrement())
  organizationId Int
  entityType     OnboardingEntityType @default(USER)
  fieldName      String
  fieldLabel     String?
  isRequired     Boolean              @default(true)
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  Organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([organizationId, entityType, fieldName], name: "unique_org_onboarding_requirement")
  @@index([organizationId])
}

