generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Tenant {
  id                 Int                 @id @default(autoincrement())
  tenantId           String              @unique // friendly name
  ownerId            Int
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  isActive           Boolean             @default(true)
  Owner              User                @relation(fields: [ownerId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Organizations      Organization[]
  UserDefaultTenants UserDefaultTenant[]
}

model User {
  id                              Int                      @id @default(autoincrement())
  userId                          String                   @unique // this is from auth0 user_id
  email                           String                   @unique
  firstName                       String?
  middleName                      String?
  lastName                        String?
  suffix                          String?
  nickname                        String?
  gender                          Gender?
  dob                             DateTime?                @db.Date
  civilStatus                     CivilStatus?
  religion                        String?
  nationality                     String?
  telephone                       String?
  mobile                          String?
  bloodType                       BloodType?
  picture                         String?
  createdAt                       DateTime                 @default(now())
  updatedAt                       DateTime                 @default(now()) @updatedAt
  deletedAt                       DateTime?
  isActive                        Boolean                  @default(true)
  Tenants                         Tenant[]
  Organizations                   UserOrganization[]       @relation("User")
  Plans                           UserPlan[]
  UserDefaultOrganization         UserDefaultOrganization?
  UserDefaultTenant               UserDefaultTenant?
  HealthcareProvider              HealthcareProvider?
  SocialLink                      SocialLink?
  AcceptedOrganizationApplication UserOrganization[]       @relation("AcceptedBy")
  ReceiptCodeClaim                ReceiptCodeClaim[]
  UserMigration                   UserMigration?
  ActivationCodes                 ActivationCode[]
}

enum Gender {
  MALE
  FEMALE
}

enum CivilStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  RH_POSITIVE
  RH_NEGATIVE
}

model Organization {
  id                       Int                       @id @default(autoincrement())
  tenantId                 Int
  orgId                    String                    @unique // friendly name
  name                     String
  description              String?
  picture                  String?
  cover                    String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  isActive                 Boolean                   @default(true)
  Tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Users                    UserOrganization[]
  UserDefaultOrganizations UserDefaultOrganization[]
  Roles                    UserOrganizationRole[]
  UserMigration            UserMigration[]
}

// This is for user to join an organization e.g. as a member, admin, healthcare provider, etc.
model UserOrganization {
  id             Int                    @id @default(autoincrement())
  userId         Int
  organizationId Int
  role           Int
  status         UserOrganizationStatus @default(PENDING)
  acceptedAt     DateTime?              @db.Date
  acceptedBy     Int?
  createdAt      DateTime               @default(now())
  User           User                   @relation("User", fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  AcceptedBy     User?                  @relation("AcceptedBy", fields: [acceptedBy], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Organization   Organization           @relation(fields: [organizationId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  UserRole       UserOrganizationRole   @relation(fields: [role], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([userId, organizationId, role], name: "unique_user_organization_role")
}

model UserOrganizationRole {
  id                Int                @id @default(autoincrement())
  orgId             Int
  name              String
  description       String?
  isActive          Boolean            @default(true)
  Organization      Organization       @relation(fields: [orgId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  UserOrganizations UserOrganization[]

  @@unique([orgId, name], name: "unique_organization_role")
}

enum UserOrganizationStatus {
  ACTIVE
  INACTIVE
  PENDING
  SUSPENDED
}

model Plan {
  id          Int        @id @default(autoincrement())
  planUid     String     @unique // friendly name
  price       Float
  name        String
  type        PlanType
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  isActive    Boolean    @default(true)
  Features    Feature[]
  Users       UserPlan[]
}

enum PlanType {
  TENANT
  HEALTHCARE_PROVIDER
}

model Feature {
  id          Int       @id @default(autoincrement())
  planId      Int
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  Plan        Plan      @relation(fields: [planId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model UserPlan {
  id        Int            @id @default(autoincrement())
  userId    Int
  planId    Int
  status    UserPlanStatus
  startDate DateTime
  endDate   DateTime
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?
  isActive  Boolean        @default(true)
  User      User           @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Plan      Plan           @relation(fields: [planId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

enum UserPlanStatus {
  ACTIVE
  INACTIVE
  ON_HOLD
  CANCELLED
  EXPIRED
  PENDING
}

// This is for user that are healthcare provider which maybe a doctor or nurse or other type of healthcare provider
model HealthcareProvider {
  id                  Int                    @id @default(autoincrement())
  userId              Int                    @unique
  type                HealthcareProviderType
  isPublished         Boolean                @default(false)
  description         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  deletedAt           DateTime?
  isActive            Boolean                @default(true)
  User                User                   @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  DoctorProfile       DoctorProfile?
  NurseProfile        NurseProfile?
  ProfessionalDetails ProfessionalDetails?
}

enum HealthcareProviderType {
  DOCTOR
  NURSE
  LAB_TECHNICIAN
  PHARMACIST
  RADIOLOGIST
  PHYSIOTHERAPIST
  OCCUPATIONAL_THERAPIST
  SPEECH_THERAPIST
  DIETITIAN
  SOCIAL_WORKER
  PSYCHOLOGIST
  PSYCHIATRIST
  DENTIST
  OPTOMETRIST
  CHIROPRACTOR
  PODIATRIST
}

model DoctorProfile {
  id                   Int                @id @default(autoincrement())
  healthcareProviderId Int                @unique
  title                String
  name                 String
  suffix               String?
  workEmail            String?
  workPhone            String?
  picture              String?
  cover                String?
  experience           String?
  education            String[]           @default([])
  fields               String[]           @default([])
  specialties          String[]           @default([])
  certifications       String[]           @default([])
  languages            String[]           @default([])
  affiliations         String[]           @default([])
  philosophy           String?            @db.Text
  areaOfInterest       String?            @db.Text
  hobbies              String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  isActive             Boolean            @default(true)
  HealthcareProvider   HealthcareProvider @relation(fields: [healthcareProviderId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model NurseProfile {
  id                   Int                @id @default(autoincrement())
  healthcareProviderId Int                @unique
  title                String
  name                 String
  suffix               String?
  workEmail            String?
  workPhone            String?
  picture              String?
  cover                String?
  experience           String?
  education            String[]           @default([])
  fields               String[]           @default([])
  specialties          String[]           @default([])
  certifications       String[]           @default([])
  languages            String[]           @default([])
  affiliations         String[]           @default([])
  philosophy           String?            @db.Text
  areaOfInterest       String?            @db.Text
  hobbies              String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  isActive             Boolean            @default(true)
  HealthcareProvider   HealthcareProvider @relation(fields: [healthcareProviderId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model ProfessionalDetails {
  id                 Int                @id @default(autoincrement())
  healthcareProverId Int                @unique
  licenseNumber      String
  licenseIssued      DateTime
  licenseExpires     DateTime
  ptrNumber          String
  taxNumber          String
  HealthCareProvider HealthcareProvider @relation(fields: [healthcareProverId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model UserDefaultOrganization {
  id             Int          @id @default(autoincrement())
  userId         Int          @unique
  organizationId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  isActive       Boolean      @default(true)
  User           User         @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model UserDefaultTenant {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  tenantId  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)
  User      User      @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Tenant    Tenant    @relation(fields: [tenantId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model SocialLink {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  website   String?
  facebook  String?
  twitter   String?
  linkedin  String?
  instagram String?
  tiktok    String?
  User      User    @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}

model ReceiptCode {
  id               Int                @id @default(autoincrement())
  coverage         Coverage
  code             String             @unique
  amount           Float
  status           ReceiptCodeStatus  @default(UNUSED)
  maxUses          Int                @default(1)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?
  isActive         Boolean            @default(true)
  ReceiptCodeClaim ReceiptCodeClaim[]
}

enum Coverage {
  ALL
  TENANT
  HEALTHCARE_PROVIDER
}

enum ReceiptCodeStatus {
  UNUSED
  USED
  EXPIRED
}

model ReceiptCodeClaim {
  id            Int         @id @default(autoincrement())
  userId        Int
  receiptCodeId Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  isActive      Boolean     @default(true)
  User          User        @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  ReceiptCode   ReceiptCode @relation(fields: [receiptCodeId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([userId, receiptCodeId], name: "unique_user_receipt_code")
}

model UserMigration {
  id           Int          @id @default(autoincrement())
  userId       Int          @unique
  orgId        Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  isActive     Boolean      @default(true)
  User         User         @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
  Organization Organization @relation(fields: [orgId], references: [id], onUpdate: NoAction, onDelete: NoAction)

  @@unique([userId, orgId], name: "unique_user_migration")
}

model ActivationCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  userId    Int
  expiresAt DateTime
  isUsed    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)
  User      User      @relation(fields: [userId], references: [id], onUpdate: NoAction, onDelete: NoAction)
}
