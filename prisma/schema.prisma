generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Tenant {
  id                 Int                 @id @default(autoincrement())
  tenantId           String              @unique // friendly name
  ownerId            Int
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  isActive           Boolean             @default(true)
  Owner              User                @relation(fields: [ownerId], references: [id])
  Organizations      Organization[]
  UserDefaultTenants UserDefaultTenant[]
}

model User {
  id                      Int                      @id @default(autoincrement())
  userId                  String                   @unique // this is from auth0 user_id
  email                   String                   @unique
  name                    String?
  picture                 String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @default(now()) @updatedAt
  deletedAt               DateTime?
  isActive                Boolean                  @default(true)
  Tenants                 Tenant[]
  Organizations           UserOrganization[]
  Plans                   UserPlan[]
  UserDefaultOrganization UserDefaultOrganization?
  UserDefaultTenant       UserDefaultTenant?
  HealthcareProvider      HealthcareProvider?
  SocialLink              SocialLink?
}

model Organization {
  id                       Int                       @id @default(autoincrement())
  tenantId                 Int
  orgId                    String                    @unique // friendly name
  name                     String
  description              String?
  picture                  String?
  cover                    String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  isActive                 Boolean                   @default(true)
  Tenant                   Tenant                    @relation(fields: [tenantId], references: [id])
  Users                    UserOrganization[]
  UserDefaultOrganizations UserDefaultOrganization[]
}

// This is for user to join an organization e.g. as a member, admin, healthcare provider, etc.
model UserOrganization {
  id             Int          @id @default(autoincrement())
  userId         Int
  organizationId Int
  role           String
  user           User         @relation(fields: [userId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Plan {
  id          Int        @id @default(autoincrement())
  planUid     String     @unique // friendly name
  price       Float
  name        String
  type        PlanType
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  isActive    Boolean    @default(true)
  Features    Feature[]
  Users       UserPlan[]
}

enum PlanType {
  TENANT
  HEALTHCARE_PROVIDER
}

model Feature {
  id          Int       @id @default(autoincrement())
  planId      Int
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  Plan        Plan      @relation(fields: [planId], references: [id])
}

model UserPlan {
  id        Int       @id @default(autoincrement())
  userId    Int
  planId    Int
  startDate DateTime
  endDate   DateTime
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)
  User      User      @relation(fields: [userId], references: [id])
  Plan      Plan      @relation(fields: [planId], references: [id])
}

// This is for user that are healthcare provider which maybe a doctor or nurse or other type of healthcare provider
model HealthcareProvider {
  id            Int                    @id @default(autoincrement())
  userId        Int                    @unique
  type          HealthcareProviderType
  description   String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  deletedAt     DateTime?
  isActive      Boolean                @default(true)
  User          User                   @relation(fields: [userId], references: [id])
  DoctorProfile DoctorProfile?
  NurseProfile  NurseProfile?
}

enum HealthcareProviderType {
  DOCTOR
  NURSE
  LAB_TECHNICIAN
  PHARMACIST
  RADIOLOGIST
  PHYSIOTHERAPIST
  OCCUPATIONAL_THERAPIST
  SPEECH_THERAPIST
  DIETITIAN
  SOCIAL_WORKER
  PSYCHOLOGIST
  PSYCHIATRIST
  DENTIST
  OPTOMETRIST
  CHIROPRACTOR
  PODIATRIST
}

model DoctorProfile {
  id                   Int                @id @default(autoincrement())
  healthcareProviderId Int                @unique
  title                String
  name                 String
  suffix               String?
  workEmail            String?
  workPhone            String?
  picture              String?
  cover                String?
  experience           String?
  education            String[]           @default([])
  fields               String[]           @default([])
  specialties          String[]           @default([])
  certifications       String[]           @default([])
  languages            String[]           @default([])
  affiliations         String[]           @default([])
  philosophy           String?            @db.Text
  areaOfInterest       String?            @db.Text
  hobbies              String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  isActive             Boolean            @default(true)
  HealthcareProvider   HealthcareProvider @relation(fields: [healthcareProviderId], references: [id])
}

model NurseProfile {
  id                   Int                @id @default(autoincrement())
  healthcareProviderId Int                @unique
  title                String
  name                 String
  suffix               String?
  workEmail            String?
  workPhone            String?
  picture              String?
  cover                String?
  experience           String?
  education            String[]           @default([])
  fields               String[]           @default([])
  specialties          String[]           @default([])
  certifications       String[]           @default([])
  languages            String[]           @default([])
  affiliations         String[]           @default([])
  philosophy           String?            @db.Text
  areaOfInterest       String?            @db.Text
  hobbies              String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  isActive             Boolean            @default(true)
  HealthcareProvider   HealthcareProvider @relation(fields: [healthcareProviderId], references: [id])
}

model UserDefaultOrganization {
  id             Int          @id @default(autoincrement())
  userId         Int          @unique
  organizationId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  isActive       Boolean      @default(true)
  User           User         @relation(fields: [userId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id])
}

model UserDefaultTenant {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  tenantId  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)
  User      User      @relation(fields: [userId], references: [id])
  Tenant    Tenant    @relation(fields: [tenantId], references: [id])
}

model SocialLink {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  website   String?
  facebook  String?
  twitter   String?
  linkedin  String?
  instagram String?
  tiktok    String?
  User      User    @relation(fields: [userId], references: [id])
}
