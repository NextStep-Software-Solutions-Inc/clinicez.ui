enum Severity {
  MILD
  MODERATE
  SEVERE
  CRITICAL
  PROFOUND
  UNKNOWN
}

enum Gender {
  MALE
  FEMALE
}

enum CivilStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  SEPARATED
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
  RH_POSITIVE
  RH_NEGATIVE
  UNKNOWN
}

enum PlanType {
  TENANT
  HEALTHCARE_PROVIDER
}

enum UserPlanStatus {
  ACTIVE
  INACTIVE
  ON_HOLD
  CANCELLED
  EXPIRED
  PENDING
}

enum Coverage {
  ALL
  TENANT
  HEALTHCARE_PROVIDER
}

enum ReceiptCodeStatus {
  UNUSED
  USED
  EXPIRED
}

model HealthcareProviderType {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique
  description         String?
  deletedAt           DateTime?
  isActive            Boolean              @default(true)
  HealthcareProviders HealthcareProvider[]
}

model UserSchedule {
  id          Int       @id @default(autoincrement())
  userId      Int
  daysOfWeek  Int[]     @default([])
  weekOfMonth Int[]     @default([])
  startTime   String
  endTime     String
  startDate   DateTime  @db.Date()
  endDate     DateTime  @db.Date()
  type        String    @default("base")
  pattern     String    @default("weekly")
  isRecurring Boolean   @default(false)
  isActive    Boolean   @default(true)
  isAvailable Boolean   @default(true)
  priority    Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  User        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, startDate, endDate], name: "user_schedule_index")
}

model ReservedTimeSlot {
  id                 Int                @id @default(autoincrement())
  jobId              String             @unique
  hpId               Int
  reservedBy         Int
  startDateTime      DateTime
  endDateTime        DateTime
  reservedAt         DateTime
  User               User               @relation(fields: [reservedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  HealthCareProvider HealthcareProvider @relation(fields: [hpId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([hpId, reservedBy, startDateTime, endDateTime], name: "reserved_time_slot_index")
}

model Booking {
  id            Int      @id @default(autoincrement())
  jobId         String   @unique
  routingCode   String?
  bookedFor     Int
  bookedBy      Int
  startDateTime DateTime
  endDateTime   DateTime
  bookedAt      DateTime
  meetingLink   String?
  platform      String?
  BookedBy      User     @relation(name: "BookedBy", fields: [bookedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  BookedFor     User     @relation(name: "BookedFor", fields: [bookedFor], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Clinic {
  id                              Int                              @id @default(autoincrement())
  tenantId                        Int
  clinicUid                       String                           @unique
  name                            String
  description                     String?
  logo                            String?
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  deletedAt                       DateTime?
  isActive                        Boolean                          @default(true)
  customUrl                       String?
  email                           String?
  privacyPolicyUrl                String?
  termsAndConditionsUrl           String?
  Tenant                          Tenant                           @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Appointments                    Appointment[]
  AppointmentTypes                AppointmentType[]
  AppointmentModes                AppointmentMode[]
  ServiceCategories               ServiceCategory[]
  ConsultationTickets             ConsultationTicket[]
  Systems                         System[]
  PreAssessmentNotes              PreAssessmentNote[]
  Interventions                   Intervention[]
  ClinicMembers                   ClinicMember[]
  ClinicMemberRoles               ClinicMemberRole[]
  AppointmentConfig               AppointmentConfig?
  ConsultationConfig              ConsultationConfig?
  ClinicAppointmentTabs           ClinicAppointmentTab[]
  ClinicOrganizations             ClinicOrganization[]
  ClinicSetting                   ClinicSetting?
  UserClinicAppointmentWhitelists UserClinicAppointmentWhitelist[]
  FileTypeAttributes              FileTypeAttribute[]
  FolderSettings                  FolderSetting[]
  UserDefaultClinicRole           UserDefaultClinicRole[]

  @@index([tenantId, clinicUid], name: "clinic_index")
}

model ClinicSetting {
  id                    Int     @id @default(autoincrement())
  clinicId              Int     @unique
  isPublic              Boolean @default(false)
  sendEmailNotification Boolean @default(true)
  emailToClinicOnly     Boolean @default(false)
  enableAppointment     Boolean @default(true)
  enableConsultation    Boolean @default(true)
  Clinic                Clinic  @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ClinicMember {
  id                      Int                      @id @default(autoincrement())
  clinicId                Int
  userId                  Int
  roleId                  Int
  status                  String                   @default("PENDING")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  deletedAt               DateTime?
  isActive                Boolean                  @default(true)
  Clinic                  Clinic                   @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User                    User                     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Role                    ClinicMemberRole?        @relation(fields: [roleId], references: [id])
  ClinicMemberPermissions ClinicMemberPermission[]

  @@unique([clinicId, userId, roleId], name: "unique_clinic_member")
}

model ClinicOrganization {
  id             Int          @id @default(autoincrement())
  clinicId       Int
  organizationId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  isActive       Boolean      @default(true)
  Clinic         Clinic       @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([clinicId, organizationId], name: "unique_clinic_organization")
}

model ClinicMemberRole {
  id                        Int                        @id @default(autoincrement())
  clinicId                  Int
  name                      String
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  isActive                  Boolean                    @default(true)
  Clinic                    Clinic                     @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ClinicMembers             ClinicMember[]
  ClinicRoleAppointmentTabs ClinicRoleAppointmentTab[]
  UserDefaultClinicRoles    UserDefaultClinicRole[]

  @@unique([clinicId, name], name: "unique_clinic_member_role")
}

model AppointmentConfig {
  id                         Int       @id @default(autoincrement())
  clinicId                   Int       @unique
  maxAppointmentsPerClient   Int       @default(0)
  lastPerClientIntervalReset DateTime? @db.Date
  perClientResetInterval     Int       @default(0)
  maxAppointmentsPerDay      Int       @default(0)
  lastPerDayIntervalReset    DateTime? @db.Date
  privacyPolicyUrl           String?
  termsAndConditionsUrl      String?
  Clinic                     Clinic    @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ConsultationConfig {
  id             Int          @id @default(autoincrement())
  clinicId       Int          @unique
  noteTemplateId Int
  NoteTemplate   NoteTemplate @relation(fields: [noteTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Clinic         Clinic       @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model NoteTemplate {
  id                           Int                           @id @default(autoincrement())
  name                         String                        @unique
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  deletedAt                    DateTime?
  isActive                     Boolean                       @default(true)
  NoteSections                 NoteSection[]
  ConsultationConfigs          ConsultationConfig[]
  ConsultationTicketAttributes ConsultationTicketAttribute[]
}

model NoteSection {
  id             Int          @id @default(autoincrement())
  noteTemplateId Int
  name           String
  label          String       @default("")
  showOnPatient  Boolean      @default(true)
  description    String?
  isActive       Boolean      @default(true)
  NoteTemplate   NoteTemplate @relation(fields: [noteTemplateId], references: [id])

  @@unique([noteTemplateId, name], name: "unique_note_section")
}

model ClinicAppointmentTab {
  id                        Int                        @id @default(autoincrement())
  clinicId                  Int
  appointmentTabId          Int
  Clinic                    Clinic                     @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  AppointmentTab            AppointmentTab             @relation(fields: [appointmentTabId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ClinicRoleAppointmentTabs ClinicRoleAppointmentTab[]

  @@unique([clinicId, appointmentTabId], name: "unique_clinic_appointment_tab")
}

model ClinicRoleAppointmentTab {
  id                     Int                  @id @default(autoincrement())
  clinicRoleId           Int
  clinicAppointmentTabId Int
  ClinicMemberRole       ClinicMemberRole     @relation(fields: [clinicRoleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ClinicAppointmentTab   ClinicAppointmentTab @relation(fields: [clinicAppointmentTabId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([clinicRoleId, clinicAppointmentTabId], name: "unique_role_appointment_tab")
}

model AppointmentTab {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @unique
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  isActive              Boolean                @default(true)
  ClinicAppointmentTabs ClinicAppointmentTab[]
}

model Appointment {
  id                     Int                     @id @default(autoincrement())
  clinicId               Int
  subject                String
  complaint              String?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  Clinic                 Clinic                  @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Requesters             AppointmentRequester[]
  AppointmentAttribute   AppointmentAttribute?
  AppointmentRouting     AppointmentRouting[]
  AppointmentAttachments AppointmentAttachment[]
  PreAssessmentNotes     PreAssessmentNote[]
  ConsultationTickets    ConsultationTicket[]

  @@index([clinicId], name: "clinic_appointment_index")
}

model AppointmentAttachment {
  id            Int         @id @default(autoincrement())
  appointmentId Int
  name          String
  url           String
  Appointment   Appointment @relation(fields: [appointmentId], references: [id])
}

model AppointmentRequester {
  id            Int         @id @default(autoincrement())
  appointmentId Int
  userId        Int
  Appointment   Appointment @relation(fields: [appointmentId], references: [id])
  User          User        @relation(fields: [userId], references: [id])

  @@unique([appointmentId, userId], name: "unique_appointment_requester")
}

model AppointmentAttribute {
  id                 Int                 @id @default(autoincrement())
  appointmentId      Int                 @unique
  recurring          Boolean             @default(false)
  maxDuration        Int                 @default(30)
  date               DateTime?           @db.Date
  timeStart          String?
  timeEnd            String?
  modeId             Int
  typeId             Int
  serviceId          Int
  receivedAt         DateTime?
  receivedBy         Int?
  rejectedAt         DateTime?
  rejectedBy         Int?
  rejectedReason     String?
  completedAt        DateTime?
  completedBy        Int?
  rescheduledAt      DateTime?
  rescheduledBy      Int?
  rescheduledReason  String?
  status             String              @default("PENDING")
  preferredAppointee Int?
  eventId            String?             @default("")
  meetingUrl         String?             @default("")
  Appointment        Appointment         @relation(fields: [appointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  AppointmentMode    AppointmentMode     @relation(fields: [modeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  AppointmentType    AppointmentType     @relation(fields: [typeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Service            Service?            @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  PreferredAppointee HealthcareProvider? @relation(fields: [preferredAppointee], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ReceivedBy         User?               @relation(name: "ReceivedBy", fields: [receivedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  RejectedBy         User?               @relation(name: "RejectedBy", fields: [rejectedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  CompletedBy        User?               @relation(name: "CompletedBy", fields: [completedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model AppointmentType {
  id                       Int                       @id @default(autoincrement())
  clinicId                 Int
  name                     String
  description              String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  isActive                 Boolean                   @default(true)
  Clinic                   Clinic                    @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  AppointmentAttributes    AppointmentAttribute[]
  AppointmentTypeAttribute AppointmentTypeAttribute?
}

model AppointmentTypeAttribute {
  id                Int             @id @default(autoincrement())
  appointmentTypeId Int             @unique
  requirements      String[]        @default([])
  reminders         String[]        @default([])
  duration          Int             @default(30)
  durationPadding   Int             @default(0)
  specializations   String[]        @default([])
  resources         String[]        @default([])
  AppointmentType   AppointmentType @relation(fields: [appointmentTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model AppointmentMode {
  id                    Int                    @id @default(autoincrement())
  clinicId              Int
  name                  String
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  isActive              Boolean                @default(true)
  AppointmentAttributes AppointmentAttribute[]
  Clinic                Clinic                 @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model AppointmentRouting {
  id            Int                @id @default(autoincrement())
  routingCode   String             @unique @default(cuid())
  appointmentId Int
  routedBy      Int
  routedTo      Int
  status        String             @default("PENDING")
  amendment     String?
  amendedAt     DateTime?
  amendedBy     Int?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  Appointment   Appointment        @relation(fields: [appointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  RoutedBy      User               @relation(name: "RoutedBy", fields: [routedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  RoutedTo      HealthcareProvider @relation(name: "RoutedTo", fields: [routedTo], references: [id], onDelete: NoAction, onUpdate: NoAction)
  AmendedBy     User?              @relation(name: "AmendedBy", fields: [amendedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([appointmentId, routedTo], name: "unique_appointment_routing")
}

model ServiceCategory {
  id          Int       @id @default(autoincrement())
  clinicId    Int
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  Services    Service[]
  Clinic      Clinic    @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Service {
  id                    Int                    @id @default(autoincrement())
  name                  String
  description           String?
  categoryId            Int
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  isActive              Boolean                @default(true)
  ServiceCategory       ServiceCategory        @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  AppointmentAttributes AppointmentAttribute[]
  ServiceAttribute      ServiceAttribute?
}

model ServiceAttribute {
  id              Int      @id @default(autoincrement())
  serviceId       Int      @unique
  requirements    String[] @default([])
  reminders       String[] @default([])
  duration        Int      @default(30)
  durationPadding Int      @default(0)
  specializations String[] @default([])
  resources       String[] @default([])
  Service         Service  @relation(fields: [serviceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ConsultationTicket {
  id                          Int                          @id @default(autoincrement())
  systemId                    Int
  appointmentId               Int?
  clinicId                    Int
  subject                     String?                      @default("")
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  isActive                    Boolean                      @default(true)
  isArchived                  Boolean                      @default(false)
  Clinic                      Clinic                       @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Appointment                 Appointment?                 @relation(fields: [appointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  System                      System                       @relation(fields: [systemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ConsultationNotes           ConsultationNote[]
  ConsultationTicketAttribute ConsultationTicketAttribute?
  Interventions               Intervention[]
  ConsultationTicketHPs       ConsultationTicketHP[]
  Medications                 Medication[]
}

model ConsultationTicketHP {
  id                   Int                @id @default(autoincrement())
  consultationTicketId Int
  hpId                 Int
  ConsultationTicket   ConsultationTicket @relation(fields: [consultationTicketId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  HealthCareProvider   HealthcareProvider @relation(fields: [hpId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([consultationTicketId, hpId], name: "unique_consultation_hp")
}

model ConsultationTicketAttribute {
  id                      Int                @id @default(autoincrement())
  consultationTicketId    Int                @unique
  status                  String             @default("PROCESSING")
  noteTemplateId          Int
  allowOtherHPToAddVitals Boolean            @default(false)
  allowPatientToAddVitals Boolean            @default(false)
  whitelistEmails         String[]           @default([])
  ConsultationTicket      ConsultationTicket @relation(fields: [consultationTicketId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  NoteTemplate            NoteTemplate       @relation(fields: [noteTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model System {
  id                  Int                  @id @default(autoincrement())
  clinicId            Int
  name                String
  isActive            Boolean              @default(true)
  Clinic              Clinic               @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ConsultationTickets ConsultationTicket[]
}

model ConsultationNote {
  id                   Int                @id @default(autoincrement())
  consultationTicketId Int
  section              String
  hpId                 Int
  content              String
  showOnPatient        Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  ConsultationTicket   ConsultationTicket @relation(fields: [consultationTicketId], references: [id])
  HealthCareProvider   HealthcareProvider @relation(fields: [hpId], references: [id])

  @@unique([consultationTicketId, section, hpId], name: "unique_consultation_section")
}

model PreAssessmentNote {
  id                         Int                         @id @default(autoincrement())
  appointmentId              Int
  clinicId                   Int
  assessment                 String
  homeInstructions           String?
  remarks                    String
  createdBy                  Int
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  Appointment                Appointment                 @relation(fields: [appointmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Clinic                     Clinic                      @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  CreatedBy                  User                        @relation(fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  PreAssessmentNoteAttribute PreAssessmentNoteAttribute?

  @@unique([appointmentId, createdBy], name: "unique_appointment_created_by")
}

model PreAssessmentNoteAttribute {
  id                  Int               @id @default(autoincrement())
  preAssessmentNoteId Int               @unique
  whitelistEmails     String[]          @default([])
  PreAssessmentNote   PreAssessmentNote @relation(fields: [preAssessmentNoteId], references: [id])
}

model Intervention {
  id                   Int                @id @default(autoincrement())
  clinicId             Int
  hpId                 Int
  consultationTicketId Int
  actionId             Int
  details              String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  isActive             Boolean            @default(true)
  ConsultationTicket   ConsultationTicket @relation(fields: [consultationTicketId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Action               Action             @relation(fields: [actionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Clinic               Clinic             @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  HealthCareProvider   HealthcareProvider @relation(fields: [hpId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Action {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  isActive      Boolean        @default(true)
  Interventions Intervention[]
}

model Prescription {
  id               Int              @id @default(autoincrement())
  clinicId         Int
  medicationId     Int
  templateId       Int
  hpId             Int
  name             String?
  isArchived       Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  dateArchived     DateTime?
  DocumentTemplate DocumentTemplate @relation(fields: [templateId], references: [id])
  Medication       Medication       @relation(fields: [medicationId], references: [id])

  @@index([clinicId, medicationId, templateId], name: "prescription_index")
}

model Drug {
  id              Int              @id @default(autoincrement())
  brandName       String
  genericName     String
  MedicationDrugs MedicationDrug[]
}

model Medication {
  id                   Int                @id @default(autoincrement())
  clinicId             Int
  hpId                 Int
  patientId            Int
  consultationTicketId Int
  name                 String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  completedAt          DateTime?
  MedicationDrugs      MedicationDrug[]
  Prescriptions        Prescription[]
  ConsultationTicket   ConsultationTicket @relation(fields: [consultationTicketId], references: [id])

  @@index([patientId, hpId, consultationTicketId], name: "medication_index")
}

model MedicationDrug {
  id           Int        @id @default(autoincrement())
  medicationId Int
  drugId       Int
  isGeneric    Boolean    @default(false)
  dosage       String
  quantity     Int        @default(1)
  unit         String?
  notes        String?
  daysCount    Int?
  Drug         Drug       @relation(fields: [drugId], references: [id])
  Medication   Medication @relation(fields: [medicationId], references: [id])
}

model DocumentTemplate {
  id                         Int                         @id @default(autoincrement())
  clinicId                   Int
  name                       String
  type                       Int
  htmlContent                String
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  deletedAt                  DateTime?
  isActive                   Boolean                     @default(true)
  DocumentTemplateType       DocumentTemplateType        @relation(fields: [type], references: [id])
  Prescriptions              Prescription[]
  ClinicPrescriptionSettings ClinicPrescriptionSetting[] @relation("prescription")
}

model DocumentTemplateType {
  id                Int                @id @default(autoincrement())
  name              String
  description       String?
  DocumentTemplates DocumentTemplate[]
}

model ClinicPrescriptionSetting {
  id                     Int               @id @default(autoincrement())
  clinicId               Int
  prescriptionTemplateId Int?
  PrescriptioTemplate    DocumentTemplate? @relation(name: "prescription", fields: [prescriptionTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
