generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
  engineType    = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Tenant {
  id                 Int                 @id @default(autoincrement())
  tenantUid          String              @unique
  ownerId            Int
  name               String
  description        String?
  userPlanId         Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  isActive           Boolean             @default(true)
  UserPlan           UserPlan?           @relation(fields: [userPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Owner              User                @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Organizations      Organization[]
  TenantSetting      TenantSetting?
  UserDefaultTenants UserDefaultTenant[]
  Clinics            Clinic[]
}

model TenantSetting {
  id                      Int     @id @default(autoincrement())
  tenantId                Int     @unique
  onPremise               Boolean @default(false)
  storageConnectionString String?
  dbConnectionString      String?
  Tenant                  Tenant  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model User {
  id                               Int                              @id @default(autoincrement())
  userId                           String                           @unique
  email                            String                           @unique
  picture                          String?
  createdAt                        DateTime                         @default(now())
  deletedAt                        DateTime?
  isActive                         Boolean                          @default(true)
  updatedAt                        DateTime                         @default(now()) @updatedAt
  bloodType                        BloodType?
  civilStatus                      CivilStatus?
  dob                              DateTime?                        @db.Date
  firstName                        String?
  gender                           Gender?
  lastName                         String?
  middleName                       String?
  mobile                           String?
  nationality                      String?
  nickname                         String?
  religion                         String?
  suffix                           String?
  telephone                        String?
  ActivationCodes                  ActivationCode[]
  Folders                          Folder[]
  HealthcareProviders              HealthcareProvider[]
  ReceiptCodeClaims                ReceiptCodeClaim[]
  SocialLink                       SocialLink?
  Tenants                          Tenant[]
  UserAddresses                    UserAddress[]
  UserAllergies                    UserAllergy[]
  UserDefaultOrganization          UserDefaultOrganization?
  UserDefaultOrganizationRoles     UserDefaultOrganizationRole[]
  UserDefaultTenant                UserDefaultTenant?
  DiagnosedUserDisabilities        UserDisability[]                 @relation("DiagnosedUserDisability")
  UserDisabilities                 UserDisability[]                 @relation("UserDisability")
  UserEmergencyContacts            UserEmergencyContact[]
  UserEmployments                  UserEmploymentRecord[]
  DiagnosedUserHealthConditions    UserHealthCondition[]            @relation("DiagnosedUserHealthCondition")
  ResolvedUserHealthConditions     UserHealthCondition[]            @relation("ResolvedUserHealthCondition")
  UserHealthConditions             UserHealthCondition[]            @relation("HealthCondition")
  UserMigration                    UserMigration?
  AcceptedOrganizationApplications OrganizationMember[]             @relation("AcceptedBy")
  Organizations                    OrganizationMember[]             @relation("User")
  Plans                            UserPlan[]
  StudentRecords                   UserStudentRecord[]
  UserVaccinations                 UserVaccination[]
  VitalSigns                       VitalSign[]
  UserSchedules                    UserSchedule[]
  UserPermissions                  UserPermission[]
  ReservedTimeSlots                ReservedTimeSlot[]
  BookedByBookings                 Booking[]                        @relation("BookedBy")
  BookedForBookings                Booking[]                        @relation("BookedFor")
  UserPreference                   UserPreference?
  UserClinicAppointmentWhitelists  UserClinicAppointmentWhitelist[]
  AppointmentRequesters            AppointmentRequester[]
  RoutedAppointments               AppointmentRouting[]             @relation("RoutedBy")
  AmendedAppointments              AppointmentRouting[]             @relation("AmendedBy")
  ClinicMembers                    ClinicMember[]
  ReceivedByAppointments           AppointmentAttribute[]           @relation("ReceivedBy")
  RejectedByAppointments           AppointmentAttribute[]           @relation("RejectedBy")
  CompletedByAppointments          AppointmentAttribute[]           @relation("CompletedBy")
  PreAssessmentNotes               PreAssessmentNote[]
  UserDefaultClinicRole            UserDefaultClinicRole[]
}

model UserPreference {
  id                              Int                 @id @default(autoincrement())
  userId                          Int                 @unique
  autoAcceptAppointmentAssignment Boolean             @default(false)
  autoAssignAppointmentToSelf     Boolean             @default(false)
  defaultHpId                     Int?
  HealthCareProvider              HealthcareProvider? @relation(fields: [defaultHpId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User                            User                @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Organization {
  id                           Int                           @id @default(autoincrement())
  tenantId                     Int
  orgUid                       String                        @unique
  name                         String
  description                  String?
  logo                         String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  deletedAt                    DateTime?
  isActive                     Boolean                       @default(true)
  customUrl                    String?
  email                        String?
  privacyPolicyUrl             String?
  termsAndConditionsUrl        String?
  Tenant                       Tenant                        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  YearLevels                   OrganizationYearLevel[]
  Colleges                     OrganizationCollege[]
  Departments                  OrganizationDepartment[]
  Offices                      OrganizationOffice[]
  Programs                     OrganizationProgram[]
  OrganizationSetting          OrganizationSetting?
  UserDefaultOrganizations     UserDefaultOrganization[]
  UserDefaultOrganizationRoles UserDefaultOrganizationRole[]
  UserEmployments              UserEmploymentRecord[]
  UserMigrations               UserMigration[]
  OrganizationMembers          OrganizationMember[]
  OrganizationRoles            OrganizationRole[]
  UserStudentRecords           UserStudentRecord[]
  OrgRoleInitialPermissions    OrgRoleInitialPermission[]
  ClinicOrganizations          ClinicOrganization[]
}

model OrganizationSetting {
  id                    Int          @id @default(autoincrement())
  orgId                 Int          @unique
  isPublic              Boolean      @default(false)
  sendEmailNotification Boolean      @default(true)
  emailToOrgOnly        Boolean      @default(false)
  Organization          Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model OrgMemberPermission {
  id                 Int                @id @default(autoincrement())
  orgMemberId        Int
  permissionId       Int
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  Permission         Permission         @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OrganizationMember OrganizationMember @relation(fields: [orgMemberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ClinicMemberPermission {
  id             Int          @id @default(autoincrement())
  clinicMemberId Int
  permissionId   Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ClinicMember   ClinicMember @relation(fields: [clinicMemberId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model UserPermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  isActive     Boolean    @default(true)
  User         User       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Permission   Permission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model OrgRoleInitialPermission {
  id               Int              @id @default(autoincrement())
  orgId            Int
  orgRoleId        Int
  permissionId     Int
  Organization     Organization     @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Permission       Permission       @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OrganizationRole OrganizationRole @relation(fields: [orgRoleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([orgId, orgRoleId, permissionId], name: "unique_org_role_permission")
}

model Permission {
  id                        Int                        @id @default(autoincrement())
  name                      String                     @unique
  description               String?
  type                      String                     @default("USER")
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  deletedAt                 DateTime?
  isActive                  Boolean                    @default(true)
  OrgMemberPermissions      OrgMemberPermission[]
  UserPermissions           UserPermission[]
  OrgRoleInitialPermissions OrgRoleInitialPermission[]
  ClinicMemberPermission    ClinicMemberPermission[]
}

model OrganizationMember {
  id                   Int                   @id @default(autoincrement())
  userId               Int
  organizationId       Int
  acceptedAt           DateTime?             @db.Date
  acceptedBy           Int?
  createdAt            DateTime              @default(now())
  status               String                @default("PENDING")
  role                 Int
  AcceptedBy           User?                 @relation("AcceptedBy", fields: [acceptedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OrganizationRole     OrganizationRole      @relation(fields: [role], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User                 User                  @relation("User", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OrgMemberPermissions OrgMemberPermission[]

  @@unique([userId, organizationId, role], name: "unique_user_organization_role")
}

model OrganizationRole {
  id                           Int                           @id @default(autoincrement())
  orgId                        Int
  name                         String
  description                  String?
  isActive                     Boolean                       @default(true)
  requirements                 String[]                      @default([])
  Organization                 Organization                  @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  UserDefaultOrganizationRoles UserDefaultOrganizationRole[]
  UserEmploymentRecords        UserEmploymentRecord[]
  OrganizationMembers          OrganizationMember[]
  UserStudentRecords           UserStudentRecord[]
  OrgRoleInitialPermissions    OrgRoleInitialPermission[]

  @@unique([orgId, name], name: "unique_organization_role")
}

model Plan {
  id                   Int        @id @default(autoincrement())
  planUid              String     @unique
  price                Float
  firstPaymentDiscount Float      @default(0)
  currency             String     @default("PHP")
  name                 String
  type                 PlanType
  frequency            String     @default("MONTHLY")
  description          String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?
  isActive             Boolean    @default(true)
  Features             Feature[]
  Users                UserPlan[]
}

model Feature {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  planId      Int
  Plan        Plan      @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model UserPlan {
  id                  Int                  @id @default(autoincrement())
  userId              Int
  planId              Int
  startDate           DateTime
  endDate             DateTime
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  isActive            Boolean              @default(true)
  status              UserPlanStatus
  Plan                Plan                 @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User                User                 @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Tenants             Tenant[]
  HealthcareProviders HealthcareProvider[]
}

model HealthcareProvider {
  id                    Int                    @id @default(autoincrement())
  userId                Int
  userPlanId            Int?
  hpTypeId              Int
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  isActive              Boolean                @default(true)
  isPublished           Boolean                @default(false)
  User                  User                   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  UserPlan              UserPlan?              @relation(fields: [userPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  HPType                HealthcareProviderType @relation(fields: [hpTypeId], references: [id])
  ProfessionalDetails   ProfessionalDetails?
  ReservedTimeSlots     ReservedTimeSlot[]
  HPProfile             HPProfile?
  UserPreferences       UserPreference[]
  AppointmentRoutings   AppointmentRouting[]   @relation("RoutedTo")
  Interventions         Intervention[]
  UserVaccinations      UserVaccination[]
  ConsultationTicketHPs ConsultationTicketHP[]
  ConsultationNote      ConsultationNote[]
  AppointmentAttributes AppointmentAttribute[]

  @@unique([userId, hpTypeId], name: "unique_user_hp_type")
}

model HPProfile {
  id                   Int                @id @default(autoincrement())
  healthcareProviderId Int                @unique
  title                String
  name                 String
  suffix               String?
  picture              String?
  cover                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  isActive             Boolean            @default(true)
  affiliations         String[]           @default([])
  areaOfInterest       String?
  certifications       String[]           @default([])
  experience           String?
  fields               String[]           @default([])
  hobbies              String?
  languages            String[]           @default([])
  philosophy           String?
  specialties          String[]           @default([])
  workEmail            String?
  workPhone            String?
  educations           String[]           @default([])
  HealthcareProvider   HealthcareProvider @relation(fields: [healthcareProviderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ProfessionalDetails {
  id                 Int                @id @default(autoincrement())
  healthcareProverId Int                @unique
  licenseNumber      String
  licenseIssued      DateTime
  licenseExpires     DateTime
  ptrNumber          String
  taxNumber          String
  HealthCareProvider HealthcareProvider @relation(fields: [healthcareProverId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model UserDefaultOrganization {
  id             Int          @id @default(autoincrement())
  userId         Int          @unique
  organizationId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  isActive       Boolean      @default(true)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User           User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model UserDefaultOrganizationRole {
  id               Int              @id @default(autoincrement())
  userId           Int
  organizationId   Int
  roleId           Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  isActive         Boolean          @default(true)
  Organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OrganizationRole OrganizationRole @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User             User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, organizationId, roleId], name: "unique_user_organization_role")
}

model UserDefaultClinicRole {
  id               Int              @id @default(autoincrement())
  userId           Int
  clinicId         Int
  roleId           Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  isActive         Boolean          @default(true)
  Clinic           Clinic           @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ClinicMemberRole ClinicMemberRole @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User             User             @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, clinicId, roleId], name: "unique_user_clinic_role")
}

model UserDefaultTenant {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  tenantId  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)
  Tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model SocialLink {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  facebook  String?
  instagram String?
  linkedin  String?
  tiktok    String?
  twitter   String?
  website   String?
  User      User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ReceiptCode {
  id                Int                @id @default(autoincrement())
  coverage          Coverage
  code              String             @unique
  amount            Float
  status            ReceiptCodeStatus  @default(UNUSED)
  maxUses           Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  isActive          Boolean            @default(true)
  ReceiptCodeClaims ReceiptCodeClaim[]
}

model ReceiptCodeClaim {
  id            Int         @id @default(autoincrement())
  userId        Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  isActive      Boolean     @default(true)
  receiptCodeId Int
  ReceiptCode   ReceiptCode @relation(fields: [receiptCodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User          User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, receiptCodeId], name: "unique_user_receipt_code")
}

model UserMigration {
  id           Int          @id @default(autoincrement())
  userId       Int          @unique
  orgId        Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  isActive     Boolean      @default(true)
  Organization Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User         User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, orgId], name: "unique_user_migration")
}

model ActivationCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  userId    Int
  expiresAt DateTime
  isUsed    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)
  User      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Folder {
  id            Int            @id @default(autoincrement())
  userId        Int
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  isActive      Boolean        @default(true)
  Files         File[]
  User          User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  FolderSetting FolderSetting?

  @@unique([userId, name], name: "unique_user_folder")
}

model FolderSetting {
  id            Int     @id @default(autoincrement())
  folderId      Int     @unique
  scopeClinicId Int?
  isPublic      Boolean @default(false)
  Folder        Folder  @relation(fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Clinic        Clinic? @relation(fields: [scopeClinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model File {
  id          Int          @id @default(autoincrement())
  folderId    Int
  fileTypeId  Int
  name        String
  size        Int
  url         String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  isActive    Boolean      @default(true)
  dateTaken   DateTime?
  FileType    FileType     @relation(fields: [fileTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Folder      Folder       @relation(fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  FileSetting FileSetting?

  @@unique([folderId, name], name: "unique_folder_file")
}

model FileSetting {
  id       Int     @id @default(autoincrement())
  fileId   Int     @unique
  isPublic Boolean @default(false)
  File     File    @relation(fields: [fileId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model FileType {
  id                Int                @id @default(autoincrement())
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  isActive          Boolean            @default(true)
  Files             File[]
  FileTypeAttribute FileTypeAttribute?
}

model FileTypeAttribute {
  id                Int       @id @default(autoincrement())
  fileTypeId        Int       @unique
  required          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?
  isActive          Boolean   @default(true)
  scopeClinicId     Int?
  validityDays      Int       @default(0)
  dateTakenRequired Boolean   @default(true)
  FileType          FileType  @relation(fields: [fileTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Clinic            Clinic?   @relation(fields: [scopeClinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([fileTypeId, scopeClinicId], name: "unique_file_type_attribute")
}

model UserEmergencyContact {
  id           Int       @id @default(autoincrement())
  userId       Int
  isPrimary    Boolean   @default(true)
  name         String
  relationship String
  phone        String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  isActive     Boolean   @default(true)
  address      String?
  User         User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model UserAddress {
  id        Int       @id @default(autoincrement())
  userId    Int
  isPrimary Boolean   @default(true)
  address   String
  city      String
  state     String
  zipCode   String
  country   String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)
  User      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Vaccine {
  id               Int               @id @default(autoincrement())
  name             String
  description      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  isActive         Boolean           @default(true)
  type             String
  UserVaccinations UserVaccination[]
  VaccineAttribute VaccineAttribute?
  VaccineDoses     VaccineDose[]
  VaccineRoutes    VaccineRoute[]
}

model VaccineAttribute {
  id          Int     @id @default(autoincrement())
  vaccineId   Int     @unique
  effectivity Int
  Vaccine     Vaccine @relation(fields: [vaccineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Route {
  id               Int               @id @default(autoincrement())
  route            String
  description      String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  UserVaccinations UserVaccination[]
  VaccineRoutes    VaccineRoute[]
}

model Dose {
  id               Int               @id @default(autoincrement())
  dose             String
  description      String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  deletedAt        DateTime?
  UserVaccinations UserVaccination[]
  VaccineDoses     VaccineDose[]
}

model VaccineRoute {
  id        Int     @id @default(autoincrement())
  vaccineId Int
  routeId   Int
  Route     Route   @relation(fields: [routeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Vaccine   Vaccine @relation(fields: [vaccineId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vaccineId, routeId], name: "unique_vaccine_route")
}

model VaccineDose {
  id        Int     @id @default(autoincrement())
  vaccineId Int
  doseId    Int
  Dose      Dose    @relation(fields: [doseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Vaccine   Vaccine @relation(fields: [vaccineId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([vaccineId, doseId], name: "unique_vaccine_dose")
}

model UserVaccination {
  id                 Int                 @id @default(autoincrement())
  userId             Int
  vaccineId          Int
  doseId             Int
  routeId            Int
  dateGiven          DateTime
  notes              String?
  hpId               Int?
  administeredBy     String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  isActive           Boolean             @default(true)
  HealthCareProvider HealthcareProvider? @relation(fields: [hpId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Dose               Dose                @relation(fields: [doseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Route              Route               @relation(fields: [routeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User               User                @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Vaccine            Vaccine             @relation(fields: [vaccineId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Allergen {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?
  isActive      Boolean       @default(true)
  UserAllergies UserAllergy[]
}

model UserAllergy {
  id         Int      @id @default(autoincrement())
  userId     Int
  reaction   String
  notes      String?
  allergenId Int
  Allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User       User     @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, allergenId], name: "unique_user_allergy")
}

model HealthCondition {
  id                   Int                   @id @default(autoincrement())
  name                 String                @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  isActive             Boolean               @default(true)
  UserHealthConditions UserHealthCondition[] @relation("UserHealthCondition")
}

model UserHealthCondition {
  id                Int             @id @default(autoincrement())
  userId            Int
  healthConditionId Int
  dateDiagnosed     DateTime?
  severity          Severity
  notes             String?
  dateResolved      DateTime?
  diagnosedBy       Int?
  resolvedBy        Int?
  status            String?         @default("UNRESOLVED")
  DiagnosedBy       User?           @relation("DiagnosedUserHealthCondition", fields: [diagnosedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  HealthCondition   HealthCondition @relation("UserHealthCondition", fields: [healthConditionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ResolvedBy        User?           @relation("ResolvedUserHealthCondition", fields: [resolvedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User              User            @relation("HealthCondition", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, healthConditionId], name: "unique_user_health_condition")
}

model Disability {
  id               Int              @id @default(autoincrement())
  name             String           @unique
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  isActive         Boolean          @default(true)
  UserDisabilities UserDisability[]
}

model UserDisability {
  id            Int        @id @default(autoincrement())
  userId        Int
  disabilityId  Int
  dateDiagnosed DateTime?
  severity      Severity
  notes         String?
  isManaged     Boolean?   @default(false)
  reason        String?
  diagnosedBy   Int?
  DiagnosedBy   User?      @relation("DiagnosedUserDisability", fields: [diagnosedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Disability    Disability @relation(fields: [disabilityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User          User       @relation("UserDisability", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, disabilityId], name: "unique_user_disability")
}

model VitalSign {
  id          Int       @id @default(autoincrement())
  userId      Int
  dateTaken   DateTime
  height      Float?
  weight      Float?
  bmi         Float?
  bpSystolic  Int?
  bpDiastolic Int?
  pulseRate   Int?
  temp        Float?
  spo2        Float?
  respRate    Int?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  User        User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model OrganizationDepartment {
