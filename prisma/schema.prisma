}

model OrganizationCollege {
  id                    Int                    @id @default(autoincrement())
  organizationId        Int
  name                  String
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  isActive              Boolean                @default(true)
  Organization          Organization           @relation(fields: [organizationId], references: [id])
  UserEmploymentRecords UserEmploymentRecord[]
  UserStudentRecords    UserStudentRecord[]
}

model StudentLevel {
  id             Int                 @id @default(autoincrement())
  name           String              @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?
  isActive       Boolean             @default(true)
  StudentRecords UserStudentRecord[]
}

model OrganizationYearLevel {
  id                 Int                 @id @default(autoincrement())
  organizationId     Int
  name               String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  isActive           Boolean             @default(true)
  Organization       Organization        @relation(fields: [organizationId], references: [id])
  UserStudentRecords UserStudentRecord[]
}

model UserStudentRecord {
  id                     Int                     @id @default(autoincrement())
  userId                 Int
  organizationId         Int
  studentId              String                  @unique
  lrn                    String?                 @unique
  level                  Int
  yearLevel              Int?
  programId              Int?
  departmentId           Int?
  collegeId              Int?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  isActive               Boolean                 @default(true)
  userOrganizationRoleId Int?
  College                OrganizationCollege?    @relation(fields: [collegeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Department             OrganizationDepartment? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Level                  StudentLevel            @relation(fields: [level], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Program                OrganizationProgram?    @relation(fields: [programId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User                   User                    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OrganizationRole       OrganizationRole?       @relation(fields: [userOrganizationRoleId], references: [id])
  OrganizationYearLevel  OrganizationYearLevel?  @relation(fields: [yearLevel], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, organizationId], name: "unique_user_student_record")
}

model UserClinicAppointmentWhitelist {
  id               Int               @id @default(autoincrement())
  userId           Int
  clinicId         Int
  name             String
  User             User              @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  WhitelistFilters WhitelistFilter[]

  @@unique([userId, clinicId], name: "unique_user_clinic_appointment_whitelist")
}

model WhitelistFilter {
  id                               Int                            @id @default(autoincrement())
  userClinicAppointmentWhitelistId Int
  filterId                         Int
  value                            String
  Filter                           Filter                         @relation(fields: [filterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  UserClinicAppointmentWhitelist   UserClinicAppointmentWhitelist @relation(fields: [userClinicAppointmentWhitelistId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userClinicAppointmentWhitelistId, filterId, value], name: "unique_whitelist_filter")
}

model Filter {
  id               Int               @id @default(autoincrement())
  key              String            @unique
  name             String
  WhitelistFilters WhitelistFilter[]
}

model OrganizationOffice {
  id                    Int                    @id @default(autoincrement())
  organizationId        Int
  name                  String
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  isActive              Boolean                @default(true)
  Organization          Organization           @relation(fields: [organizationId], references: [id])
  UserEmploymentRecords UserEmploymentRecord[]
}

model UserEmploymentRecord {
  id                     Int                     @id @default(autoincrement())
  userId                 Int
  organizationId         Int
  employeeId             String                  @unique
  position               String
  designation            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  isActive               Boolean                 @default(true)
  collegeId              Int?
  departmentId           Int?
  officeId               Int?
  userOrganizationRoleId Int?
  College                OrganizationCollege?    @relation(fields: [collegeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Department             OrganizationDepartment? @relation(fields: [departmentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Office                 OrganizationOffice?     @relation(fields: [officeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User                   User                    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  OrganizationRole       OrganizationRole?       @relation(fields: [userOrganizationRoleId], references: [id])

