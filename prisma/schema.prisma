  Clinic               Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ClinicPatient        ClinicPatient      @relation(fields: [clinicPatientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ConsultationTicket   ConsultationTicket @relation(fields: [consultationTicketId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  CreatedBy            User               @relation("ReferralSlipCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  DeletedBy            User?              @relation("ReferralSlipDeletedBy", fields: [deletedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  DocumentTemplate     DocumentTemplate   @relation(fields: [documentTemplateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  UpdatedBy            User?              @relation("ReferralSlipUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ClinicLaboratoryRequestDiagnostic {
  id                        Int                     @id @default(autoincrement())
  clinicLaboratoryRequestId Int
  laboratoryDiagnosticId    Int
  LaboratoryRequest         ClinicLaboratoryRequest @relation(fields: [clinicLaboratoryRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  LaboratoryDiagnostic      LaboratoryDiagnostic    @relation(fields: [laboratoryDiagnosticId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([clinicLaboratoryRequestId, laboratoryDiagnosticId], name: "unique_clinic_laboratory_request_diagnostic")
}

model ClinicImagingRequestDiagnostic {
  id                     Int                  @id @default(autoincrement())
  clinicImagingRequestId Int
  imagingDiagnosticId    Int
  ImagingRequest         ClinicImagingRequest @relation(fields: [clinicImagingRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ImagingDiagnostic      ImagingDiagnostic    @relation(fields: [imagingDiagnosticId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([clinicImagingRequestId, imagingDiagnosticId], name: "unique_clinic_imaging_request_diagnostic")
}

// Medical History models - split into logical sections for Health Assessment Form (HAF)
// These models support the PHR section and HAF PDF generation

// Past Medical History - tracks chronic conditions and diseases
// conditionId and userId should only remain, then createdAt for tracking purposes
// Conditions (checkboxes in HAF)
// these are conditions. Should only have `conditionId`, then check that condition if that person has astham, for example.
// it should only contain the condition of the patient
// `hasAllery` should only be in the allergy model
// No need for soft delete
model MedicalHistory {
  id          Int             @id @default(autoincrement())
  userId      Int
  conditionId Int
  details     String? // For condition-specific details like cancer organ, hepatitis type, TB details
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  User        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  Condition   HealthCondition @relation("MedicalHistoryCondition", fields: [conditionId], references: [id])

  @@unique([userId, conditionId])
  @@index([userId])
}

// Family Medical History - same structure as MedicalHistory but for family members
model FamilyMedicalHistory {
  id          Int             @id @default(autoincrement())
  userId      Int
  conditionId Int
  details     String? // For condition-specific details like cancer organ, hepatitis type, TB details
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?
  User        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  Condition   HealthCondition @relation("FamilyMedicalHistoryCondition", fields: [conditionId], references: [id])

  @@unique([userId, conditionId])
  @@index([userId])
}

// Surgical History - table format: operation and date
model SurgicalHistory {
  id            Int       @id @default(autoincrement())
  userId        Int
  operationName String
  operationDate DateTime? @db.Date
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  User          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Personal/Social History
model PersonalHistory {
  id                    Int       @id @default(autoincrement())
  userId                Int       @unique
  // Smoking
  smokingStatus         String? // "Yes", "No", "Quit"
  numberOfPacksPerYear  Int?
  // Alcohol
  alcoholStatus         String? // "Yes", "No", "Quit"
  numberOfBottlesPerDay Int?
  // Drugs
  illicitDrugUse        String? // "Yes", "No"
  // Sexual History
  sexuallyActive        String? // "Yes", "No"
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  deletedAt             DateTime?
  User                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// OB-Gyne History (Approved)
model ObGyneHistory {
  id                          Int       @id @default(autoincrement())
  userId                      Int       @unique
  menarche                    Int? // age
  lastMenstrualPeriod         DateTime? @db.Date
  menopauseAge                Int?
  menopauseStatus             String? // "Yes", "No"
  ageAtFirstSexualIntercourse Int?
  birthControlMethod          String?
  menstrualPeriodDuration     Int? // days
  menstrualCycleInterval      Int? // days
  numberOfPadsPerDay          Int?
  // Pregnancy history
  gravidity                   Int? // total pregnancies
  parity                      Int? // live births
  fullTerm                    Int?
  premature                   Int?
  abortion                    Int?
  livingChildren              Int?
  typeOfDelivery              String?
  hasPreEclampsia             Boolean   @default(false)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  deletedAt                   DateTime?
  User                        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Physical Examination - extends VitalSigns with additional measurements (Approved)
model PhysicalExamination {
  id                Int        @id @default(autoincrement())
  userId            Int
  vitalSignId       Int? // Link to VitalSign (optional)
  visualAcuityLeft  String?
  visualAcuityRight String?
  status            String? // e.g., "Physically Fit", "Underweight", "Overweight", "Obese"
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  deletedAt         DateTime?
  User              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  VitalSign         VitalSign? @relation(fields: [vitalSignId], references: [id])

  @@index([userId])
  @@index([vitalSignId])
}

// Pediatric measurements (0-24 months)
// Separated from general PhysicalExamination as per CEO comment
model PediatricMeasurement {
  id                       Int       @id @default(autoincrement())
  userId                   Int
  dateTaken                DateTime  @db.Date
  length                   Decimal?  @db.Decimal(5, 2) // cm
  headCircumference        Decimal?  @db.Decimal(5, 2) // cm
  skinfoldThickness        Decimal?  @db.Decimal(5, 2) // mm
  waistCircumference       Decimal?  @db.Decimal(5, 2) // cm
  hipCircumference         Decimal?  @db.Decimal(5, 2) // cm
  limbCircumference        Decimal?  @db.Decimal(5, 2) // cm
  midUpperArmCircumference Decimal?  @db.Decimal(5, 2) // cm
  remarks                  String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?
  User                     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dateTaken])
}

