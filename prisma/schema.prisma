generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Tenant {
  id                 Int                 @id @default(autoincrement())
  tenantUid          String              @unique
  ownerId            Int
  name               String
  description        String?
  userPlanId         Int?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  isActive           Boolean             @default(true)
  Clinics            Clinic[]
  Organizations      Organization[]
  Owner              User                @relation(fields: [ownerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  UserPlan           UserPlan?           @relation(fields: [userPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  TenantSetting      TenantSetting?
  UserDefaultTenants UserDefaultTenant[]
}

model TenantSetting {
  id                      Int     @id @default(autoincrement())
  tenantId                Int     @unique
  onPremise               Boolean @default(false)
  storageConnectionString String?
  dbConnectionString      String?
  Tenant                  Tenant  @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model User {
  id                               Int                              @id @default(autoincrement())
  userId                           String                           @unique
  email                            String                           @unique
  picture                          String?
  createdAt                        DateTime                         @default(now())
  deletedAt                        DateTime?
  isActive                         Boolean                          @default(true)
  updatedAt                        DateTime                         @default(now()) @updatedAt
  bloodType                        BloodType?
  civilStatus                      CivilStatus?
  dob                              DateTime?                        @db.Date
  placeOfBirth                     String?
  firstName                        String?
  gender                           Gender?
  lastName                         String?
  middleName                       String?
  mobile                           String?
  nationality                      String?
  nickname                         String?
  religion                         String?
  suffix                           String?
  telephone                        String?
  ActivationCodes                  ActivationCode[]
  CompletedByAppointments          AppointmentAttribute[]           @relation("CompletedBy")
  ReceivedByAppointments           AppointmentAttribute[]           @relation("ReceivedBy")
  RejectedByAppointments           AppointmentAttribute[]           @relation("RejectedBy")
  RescheduledByAppointments        AppointmentAttribute[]           @relation("RescheduledBy")
  AppointmentRequesters            AppointmentRequester[]
  AmendedAppointments              AppointmentRouting[]             @relation("AmendedBy")
  RoutedAppointments               AppointmentRouting[]             @relation("RoutedBy")
  BookedByBookings                 Booking[]                        @relation("BookedBy")
  BookedForBookings                Booking[]                        @relation("BookedFor")
  ImagingRequestsCreated           ClinicImagingRequest[]           @relation("ImagingRequestCreatedBy")
  ImagingRequestsDeleted           ClinicImagingRequest[]           @relation("ImagingRequestDeletedBy")
  ImagingRequestsUpdated           ClinicImagingRequest[]           @relation("ImagingRequestUpdatedBy")
  LaboratoryRequestsCreated        ClinicLaboratoryRequest[]        @relation("LaboratoryRequestCreatedBy")
  LaboratoryRequestsDeleted        ClinicLaboratoryRequest[]        @relation("LaboratoryRequestDeletedBy")
  LaboratoryRequestsUpdated        ClinicLaboratoryRequest[]        @relation("LaboratoryRequestUpdatedBy")
  MedicalCertificatesCreated       ClinicMedicalCertificate[]       @relation("MedicalCertificateCreatedBy")
  MedicalCertificatesDeleted       ClinicMedicalCertificate[]       @relation("MedicalCertificateDeletedBy")
  MedicalCertificatesUpdated       ClinicMedicalCertificate[]       @relation("MedicalCertificateUpdatedBy")
  ClinicMembers                    ClinicMember[]
  ClinicPatients                   ClinicPatient[]
  ReferralSlipsCreated             ClinicReferralSlip[]             @relation("ReferralSlipCreatedBy")
  ReferralSlipsDeleted             ClinicReferralSlip[]             @relation("ReferralSlipDeletedBy")
  ReferralSlipsUpdated             ClinicReferralSlip[]             @relation("ReferralSlipUpdatedBy")
  Folders                          Folder[]
  HealthcareProviders              HealthcareProvider[]
  Medications                      Medication[]
  MedicinesCreated                 Medicine[]                       @relation("MedicineCreatedBy")
  MedicinesUpdated                 Medicine[]                       @relation("MedicineUpdatedBy")
  AcceptedOrganizationApplications OrganizationMember[]             @relation("AcceptedBy")
  OrganizationMembers              OrganizationMember[]             @relation("User")
  PhilHealthRecordsCreated         PhilHealthRecord[]               @relation("PhilHealthRecordsCreatedBy")
  PhilHealthRecordsDeleted         PhilHealthRecord[]               @relation("PhilHealthRecordsDeletedBy")
  PhilHealthRecordsUpdated         PhilHealthRecord[]               @relation("PhilHealthRecordsUpdatedBy")
  PhilHealthRecords                PhilHealthRecord[]
  PreAssessmentNotes               PreAssessmentNote[]
  PrescriptionsCreated             Prescription[]                   @relation("PrescriptionCreatedBy")
  PrescriptionsUpdated             Prescription[]                   @relation("PrescriptionUpdatedBy")
  ReceiptCodeClaims                ReceiptCodeClaim[]
  ReservedTimeSlots                ReservedTimeSlot[]
  SocialLink                       SocialLink?
  Tenants                          Tenant[]
  UserAddresses                    UserAddress[]
  UserAllergies                    UserAllergy[]
  UserClinicAppointmentWhitelists  UserClinicAppointmentWhitelist[]
  UserDefaultClinicRoles           UserDefaultClinicRole[]
  UserDefaultOrganization          UserDefaultOrganization?
  UserDefaultOrganizationRoles     UserDefaultOrganizationRole[]
  UserDefaultTenant                UserDefaultTenant?
  DiagnosedUserDisabilities        UserDisability[]                 @relation("DiagnosedUserDisability")
  UserDisabilities                 UserDisability[]                 @relation("UserDisability")
  UserEmergencyContacts            UserEmergencyContact[]
  UserEmployments                  UserEmploymentRecord[]
  DiagnosedUserHealthConditions    UserHealthCondition[]            @relation("DiagnosedUserHealthCondition")
  ResolvedUserHealthConditions     UserHealthCondition[]            @relation("ResolvedUserHealthCondition")
  UserHealthConditions             UserHealthCondition[]            @relation("HealthCondition")
  UserMigration                    UserMigration?
  UserPermissions                  UserPermission[]
  Plans                            UserPlan[]
  UserPreference                   UserPreference?
  UserSchedules                    UserSchedule[]
  StudentRecords                   UserStudentRecord[]
  UserVaccinations                 UserVaccination[]
  VitalSigns                       VitalSign[]
  MedicalHistories                 MedicalHistory[]
  FamilyMedicalHistories           FamilyMedicalHistory[]
  SurgicalHistories                SurgicalHistory[]
  PersonalHistory                  PersonalHistory?
  ObGyneHistory                    ObGyneHistory?
  PhysicalExaminations             PhysicalExamination[]
  PediatricMeasurements            PediatricMeasurement[]
}

model PhilHealthRecord {
  id                   Int                   @id @default(autoincrement())
  userId               Int
  pin                  String                @unique
  tin                  String?               @unique
  philSysId            String?               @unique
  memberTypeId         Int
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  createdBy            Int?
  updatedBy            Int?
  deletedBy            Int?
  photoUrl             String?
  PhilHealthDependents PhilHealthDependent[]
  createdByUser        User?                 @relation("PhilHealthRecordsCreatedBy", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  deletedByUser        User?                 @relation("PhilHealthRecordsDeletedBy", fields: [deletedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  PhilHealthMemberType PhilHealthMemberType  @relation(fields: [memberTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedByUser        User?                 @relation("PhilHealthRecordsUpdatedBy", fields: [updatedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model PhilHealthMemberType {
  id                Int                      @id @default(autoincrement())
  name              String                   @unique
  category          PhilHealthMemberCategory @default(DIRECT)
  parentId          Int?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  isActive          Boolean                  @default(true)
  Parent            PhilHealthMemberType?    @relation("PhilHealthMemberTypeParent", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Children          PhilHealthMemberType[]   @relation("PhilHealthMemberTypeParent")
  PhilHealthRecords PhilHealthRecord[]
}

model PhilHealthDependent {
  id                 Int              @id @default(autoincrement())
  philHealthRecordId Int
  firstName          String
  middleName         String?
  lastName           String?
  suffix             String?
  relationship       String?
  dob                DateTime?
  gender             Gender?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?
  PhilHealthRecord   PhilHealthRecord @relation(fields: [philHealthRecordId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ClinicPatient {
  id                       Int                        @id @default(autoincrement())
  clinicId                 Int
  patientId                Int
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  isActive                 Boolean                    @default(true)
  deletedAt                DateTime?
  ImagingRequests          ClinicImagingRequest[]
  ClinicLaboratoryRequest  ClinicLaboratoryRequest[]
  MedicalCertificates      ClinicMedicalCertificate[]
  Clinic                   Clinic                     @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Patient                  User                       @relation(fields: [patientId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ClinicPatientPermissions ClinicPatientPermission[]
  ClinicReferralSlips      ClinicReferralSlip[]
  Prescriptions            Prescription[]

  @@unique([clinicId, patientId], name: "unique_clinic_patient")
}

model ClinicPatientPermission {
  id              Int           @id @default(autoincrement())
  clinicPatientId Int
  permissionId    Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  ClinicPatient   ClinicPatient @relation(fields: [clinicPatientId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Permission      Permission    @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model UserPreference {
  id                              Int                 @id @default(autoincrement())
  userId                          Int                 @unique
  autoAcceptAppointmentAssignment Boolean             @default(false)
  autoAssignAppointmentToSelf     Boolean             @default(false)
  defaultHpId                     Int?
  HealthCareProvider              HealthcareProvider? @relation(fields: [defaultHpId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User                            User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Organization {
  id                           Int                           @id @default(autoincrement())
  tenantId                     Int
  orgUid                       String                        @unique
  name                         String
  description                  String?
  logo                         String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  deletedAt                    DateTime?
  isActive                     Boolean                       @default(true)
  customUrl                    String?
  email                        String?
  privacyPolicyUrl             String?
  termsAndConditionsUrl        String?
  ClinicOrganizations          ClinicOrganization[]
  OrgRoleInitialPermissions    OrgRoleInitialPermission[]
  Tenant                       Tenant                        @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Colleges                     OrganizationCollege[]
  Departments                  OrganizationDepartment[]
  OrganizationMembers          OrganizationMember[]
  Offices                      OrganizationOffice[]
  Programs                     OrganizationProgram[]
  OrganizationRoles            OrganizationRole[]
  OrganizationSetting          OrganizationSetting?
  YearLevels                   OrganizationYearLevel[]
  UserDefaultOrganizations     UserDefaultOrganization[]
  UserDefaultOrganizationRoles UserDefaultOrganizationRole[]
  UserEmployments              UserEmploymentRecord[]
  UserMigrations               UserMigration[]
  UserStudentRecords           UserStudentRecord[]
}

model OrganizationSetting {
  id                    Int          @id @default(autoincrement())
  orgId                 Int          @unique
  isPublic              Boolean      @default(false)
  sendEmailNotification Boolean      @default(true)
  emailToOrgOnly        Boolean      @default(false)
  Organization          Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model OrgMemberPermission {
  id                 Int                @id @default(autoincrement())
  orgMemberId        Int
  permissionId       Int
  OrganizationMember OrganizationMember @relation(fields: [orgMemberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Permission         Permission         @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ClinicMemberPermission {
  id             Int          @id @default(autoincrement())
  clinicMemberId Int
  permissionId   Int
  ClinicMember   ClinicMember @relation(fields: [clinicMemberId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Permission     Permission   @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model UserPermission {
  id           Int        @id @default(autoincrement())
  userId       Int
  permissionId Int
  Permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User         User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model OrgRoleInitialPermission {
  id               Int              @id @default(autoincrement())
  orgId            Int
  orgRoleId        Int
  permissionId     Int
  Organization     Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  OrganizationRole OrganizationRole @relation(fields: [orgRoleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Permission       Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([orgId, orgRoleId, permissionId], name: "unique_org_role_initial_permission")
}

model ClinicRoleInitialPermission {
  id           Int        @id @default(autoincrement())
  clinicId     Int
  clinicRoleId Int
  permissionId Int
  Clinic       Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ClinicRole   ClinicRole @relation(fields: [clinicRoleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([clinicId, clinicRoleId, permissionId], name: "unique_clinic_role_initial_permission")
}

model Permission {
  id                           Int                           @id @default(autoincrement())
  name                         String                        @unique
  description                  String?
  type                         String                        @default("USER")
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  deletedAt                    DateTime?
  isActive                     Boolean                       @default(true)
  ClinicMemberPermissions      ClinicMemberPermission[]
  ClinicPatientPermissions     ClinicPatientPermission[]
  ClinicRoleInitialPermissions ClinicRoleInitialPermission[]
  OrgMemberPermissions         OrgMemberPermission[]
  OrgRoleInitialPermissions    OrgRoleInitialPermission[]
  UserPermissions              UserPermission[]
}

model OrganizationMember {
  id                   Int                   @id @default(autoincrement())
  userId               Int
  organizationId       Int
  acceptedAt           DateTime?             @db.Date
  acceptedBy           Int?
  createdAt            DateTime              @default(now())
  status               String                @default("PENDING")
  role                 Int
  OrgMemberPermissions OrgMemberPermission[]
  AcceptedBy           User?                 @relation("AcceptedBy", fields: [acceptedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  OrganizationRole     OrganizationRole      @relation(fields: [role], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User                 User                  @relation("User", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, organizationId, role], name: "unique_user_organization_role")
}

model OrganizationRole {
  id                           Int                           @id @default(autoincrement())
  orgId                        Int
  name                         String
  description                  String?
  isActive                     Boolean                       @default(true)
  requirements                 String[]                      @default([])
  OrgRoleInitialPermissions    OrgRoleInitialPermission[]
  OrganizationMembers          OrganizationMember[]
  Organization                 Organization                  @relation(fields: [orgId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  UserDefaultOrganizationRoles UserDefaultOrganizationRole[]
  UserEmploymentRecords        UserEmploymentRecord[]
  UserStudentRecords           UserStudentRecord[]

  @@unique([orgId, name], name: "unique_organization_role")
}

model Plan {
  id                   Int        @id @default(autoincrement())
  planUid              String     @unique
  price                Float
  firstPaymentDiscount Float      @default(0)
  currency             String     @default("PHP")
  name                 String
  type                 PlanType
  frequency            String     @default("MONTHLY")
  description          String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?
  isActive             Boolean    @default(true)
  Features             Feature[]
  Users                UserPlan[]
}

model Feature {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  planId      Int
  Plan        Plan      @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model UserPlan {
  id                  Int                  @id @default(autoincrement())
  userId              Int
  planId              Int
  startDate           DateTime
  endDate             DateTime
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  deletedAt           DateTime?
  isActive            Boolean              @default(true)
  status              UserPlanStatus
  HealthcareProviders HealthcareProvider[]
  Tenants             Tenant[]
  Plan                Plan                 @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User                User                 @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model HealthcareProvider {
  id                      Int                        @id @default(autoincrement())
  userId                  Int
  userPlanId              Int?
  hpTypeId                Int
  description             String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  deletedAt               DateTime?
  isActive                Boolean                    @default(true)
  isPublished             Boolean                    @default(false)
  AppointmentAttributes   AppointmentAttribute[]
  AppointmentRoutings     AppointmentRouting[]       @relation("RoutedTo")
  ImagingRequests         ClinicImagingRequest[]
  ClinicLaboratoryRequest ClinicLaboratoryRequest[]
  MedicalCertificates     ClinicMedicalCertificate[]
  ConsultationNote        ConsultationNote[]
  ConsultationTicketHPs   ConsultationTicketHP[]
  HPProfile               HPProfile?
  HPType                  HealthcareProviderType     @relation(fields: [hpTypeId], references: [id])
  User                    User                       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  UserPlan                UserPlan?                  @relation(fields: [userPlanId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Interventions           Intervention[]
  Medications             Medication[]
  Prescriptions           Prescription[]
  ProfessionalDetails     ProfessionalDetails?
  ReservedTimeSlots       ReservedTimeSlot[]
  UserPreferences         UserPreference[]
  UserVaccinations        UserVaccination[]

  @@unique([userId, hpTypeId], name: "unique_user_hp_type")
}

model HPProfile {
  id                   Int                @id @default(autoincrement())
  healthcareProviderId Int                @unique
  title                String
  name                 String
  suffix               String?
  picture              String?
  cover                String?
  // This will be a URL to the e-signature image (blob storage from azure)
  eSignatureUrl        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  isActive             Boolean            @default(true)
  affiliations         String[]           @default([])
  areaOfInterest       String?
  certifications       String[]           @default([])
  experience           String?
  fields               String[]           @default([])
  hobbies              String?
  languages            String[]           @default([])
  philosophy           String?
  specialties          String[]           @default([])
  workEmail            String?
  workPhone            String?
  educations           String[]           @default([])
  HealthcareProvider   HealthcareProvider @relation(fields: [healthcareProviderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ProfessionalDetails {
  id                 Int                @id @default(autoincrement())
  healthcareProverId Int                @unique
  licenseNumber      String
  licenseIssued      DateTime
  licenseExpires     DateTime
  ptrNumber          String
  taxNumber          String
  HealthCareProvider HealthcareProvider @relation(fields: [healthcareProverId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model UserDefaultOrganization {
  id             Int          @id @default(autoincrement())
  userId         Int          @unique
  organizationId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  isActive       Boolean      @default(true)
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model UserDefaultOrganizationRole {
  id               Int              @id @default(autoincrement())
  userId           Int
  organizationId   Int
  roleId           Int
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  isActive         Boolean          @default(true)
  Organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  OrganizationRole OrganizationRole @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User             User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, organizationId, roleId], name: "unique_user_organization_role")
}

model UserDefaultClinicRole {
  id         Int        @id @default(autoincrement())
  userId     Int
  clinicId   Int
  roleId     Int
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?
  isActive   Boolean    @default(true)
  Clinic     Clinic     @relation(fields: [clinicId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ClinicRole ClinicRole @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, clinicId, roleId], name: "unique_user_clinic_role")
}

model UserDefaultTenant {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  tenantId  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)
  Tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model SocialLink {
  id        Int     @id @default(autoincrement())
  userId    Int     @unique
  facebook  String?
  instagram String?
  linkedin  String?
  tiktok    String?
  twitter   String?
  website   String?
  User      User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model ReceiptCode {
  id                Int                @id @default(autoincrement())
  coverage          Coverage
  code              String             @unique
  amount            Float
  status            ReceiptCodeStatus  @default(UNUSED)
  maxUses           Int                @default(1)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?
  isActive          Boolean            @default(true)
  ReceiptCodeClaims ReceiptCodeClaim[]
}

model ReceiptCodeClaim {
  id            Int         @id @default(autoincrement())
  userId        Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?
  isActive      Boolean     @default(true)
  receiptCodeId Int
  ReceiptCode   ReceiptCode @relation(fields: [receiptCodeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User          User        @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, receiptCodeId], name: "unique_user_receipt_code")
}

model UserMigration {
  id           Int          @id @default(autoincrement())
  userId       Int          @unique
  orgId        Int
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?
  isActive     Boolean      @default(true)
  Organization Organization @relation(fields: [orgId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  User         User         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, orgId], name: "unique_user_migration")
}

model ActivationCode {
  id        Int       @id @default(autoincrement())
  code      String    @unique
  userId    Int
  expiresAt DateTime
  isUsed    Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  isActive  Boolean   @default(true)
  User      User      @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Folder {
  id            Int            @id @default(autoincrement())
  userId        Int
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  isActive      Boolean        @default(true)
  Files         File[]
  User          User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  FolderSetting FolderSetting?

  @@unique([userId, name], name: "unique_user_folder")
}

model FolderSetting {
  id            Int     @id @default(autoincrement())
  folderId      Int     @unique
  scopeClinicId Int?
  isPublic      Boolean @default(false)
  Folder        Folder  @relation(fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Clinic        Clinic? @relation(fields: [scopeClinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model File {
  id          Int          @id @default(autoincrement())
  folderId    Int
  fileTypeId  Int
  name        String
  size        Int
  url         String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  isActive    Boolean      @default(true)
  dateTaken   DateTime?
