model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean   @default(false)
  metadata  Json?
  createdAt DateTime  @default(now())
  readAt    DateTime?
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

/// AI-generated clinical insight summary for a patient, cached with a validity window.
/// validUntil drives regeneration: if Now > validUntil the record is stale.
model PatientInsight {
  id                Int      @id @default(autoincrement())
  /// The patient this insight is about
  patientId         Int
  /// Optional clinic scope – insights can be clinic-specific
  clinicId          Int?
  /// The AI-generated markdown content
  content           String   @db.Text
  /// Clerk userId of the staff member who triggered generation
  generatedByUserId String
  /// When this cached insight expires and should be regenerated
  validUntil        DateTime
  createdAt         DateTime @default(now())

  Patient User    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  Clinic  Clinic? @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([patientId, clinicId])
  @@index([validUntil])
}

/// Master reference table for ICD-10 diagnosis codes.
/// Populated via the super-admin import feature; used for autocomplete in consultations.
model ICD10Code {
  id               Int      @id @default(autoincrement())
  orderNum         Int?
  code             String   @unique
  description      String
  shortDescription String?
  longDescription  String?
  hippaCovered     Boolean  @default(false)
  category         String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([code])
  @@index([category])
}

// ─── User Verification ──────────────────────────────────────────────────────

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum ValidIDLevel {
  PRIMARY
  SECONDARY
}

/// Master reference table for valid ID types that users can submit for verification.
model ValidIDType {
  id                    Int                    @id @default(autoincrement())
  name                  String                 @unique
  level                 ValidIDLevel
  description           String?
  /// Whether this ID type supports automated verification (e.g. PhilSys/PhilID)
  automatedVerification Boolean                @default(false)
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  VerificationDocuments VerificationDocument[]
}

/// A user's request to verify their identity via KYC.
model VerificationRequest {
  id                    Int                    @id @default(autoincrement())
  userId                Int
  status                VerificationStatus     @default(PENDING)
  /// Optional reviewer notes (reason for rejection, etc.)
  reviewerNotes         String?
  reviewedBy            Int?
  reviewedAt            DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  User                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  Reviewer              User?                  @relation("VerificationReviewer", fields: [reviewedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  VerificationDocuments VerificationDocument[]

  @@index([userId, status])
  @@index([status])
}

/// Individual document uploaded as part of a verification request.
model VerificationDocument {
  id                    Int                 @id @default(autoincrement())
  verificationRequestId Int
  validIdTypeId         Int
  /// URL to the uploaded ID photo
  idPhotoUrl            String
  /// URL to the selfie with the ID
  selfieWithIdUrl       String
  /// URL to the selfie without the ID
  selfieWithoutIdUrl    String
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  VerificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ValidIDType           ValidIDType         @relation(fields: [validIdTypeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// Application status for healthcare provider onboarding
enum HPApplicationStatus {
  PENDING_PROFILE
  PROFILE_COMPLETE
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

// ─── Philippine Location Reference Tables ────────────────────────────────────

/// Master reference table for Philippine regions (PSGC-based).
/// Managed via the super-admin Location Management console.
model PhRegion {
  id         Int          @id @default(autoincrement())
  code       String       @unique
  name       String
  regionName String
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  provinces  PhProvince[]

  @@index([code])
  @@index([isActive])
}

/// Master reference table for Philippine provinces (PSGC-based).
model PhProvince {
  id             Int              @id @default(autoincrement())
  code           String           @unique
  name           String
  regionCode     String
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  region         PhRegion         @relation(fields: [regionCode], references: [code])
  municipalities PhMunicipality[]

  @@index([code])
  @@index([regionCode])
  @@index([isActive])
}

/// Master reference table for Philippine cities and municipalities (PSGC-based).
model PhMunicipality {
  id           Int          @id @default(autoincrement())
  code         String       @unique
  name         String
  provinceCode String
  isCity       Boolean      @default(false)
  isCapital    Boolean      @default(false)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  province     PhProvince   @relation(fields: [provinceCode], references: [code])
  barangays    PhBarangay[]

  @@index([code])
  @@index([provinceCode])
  @@index([isActive])
}

/// Master reference table for Philippine barangays (PSGC-based).
model PhBarangay {
  id               Int            @id @default(autoincrement())
  code             String         @unique
  name             String
  municipalityCode String
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  municipality     PhMunicipality @relation(fields: [municipalityCode], references: [code])

  @@index([code])
  @@index([municipalityCode])
  @@index([isActive])
}

/// PhilHealth Konsulta batch report for XML generation and submission
model KonsultaBatchReport {
  id               String    @id @default(uuid())
  clinicId         Int
  title            String
  tagging          String // "1" or "2"
  transmittalNo    String?   @unique
  xmlPayload       String?   @db.Text
  status           String    @default("DRAFT") // DRAFT, VALIDATED, SUBMITTED
  validationResult String?   @db.Text
  submissionResult String?   @db.Text
  validatedAt      DateTime?
  submittedAt      DateTime?
  isPaid           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        Int

  Clinic        Clinic                 @relation(fields: [clinicId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  Creator       User                   @relation("KonsultaBatchReportCreator", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  BatchPatients KonsultaBatchPatient[]
}

/// Patient entry within a PhilHealth Konsulta batch report
model KonsultaBatchPatient {
  id                String  @id @default(uuid())
  batchId           String
  clinicPatientId   Int
  tagging           String // "1" or "2"
  isSelected        Boolean @default(true)
  selectedTicketIds Int[]   @default([])

  Batch         KonsultaBatchReport @relation(fields: [batchId], references: [id], onDelete: Cascade)
  ClinicPatient ClinicPatient       @relation(fields: [clinicPatientId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([batchId, clinicPatientId])
}

/// PhilHealth Konsulta coded medicine data (1:1 extension of Medicine)
model MedicinePhilHealthData {
  id                   String   @id @default(uuid())
  medicineId           Int      @unique
  category             String? // e.g., "E" essential, "NE" non-essential
  drugCode             String? // PhilHealth Drug Library code or NOMED...
  genericCode          String?
  saltCode             String?
  strengthCode         String?
  formCode             String?
  unitCode             String?
  packageCode          String?
  otherMedicine        String? // Generic name when drugCode is NOMED
  othMedDrugGrouping   String?
  route                String?
  actualUnitPrice      Decimal? @db.Decimal(10, 2)
  totalAmtPrice        Decimal? @db.Decimal(10, 2)
  instructionQuantity  String?
  instructionStrength  String?
  instructionFrequency String?
  isApplicable         String?  @default("Y")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  Medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
}

/// PhilHealth Konsulta diagnostic exam result — linked to either a Profile (P-prefix) or SOAP (S-prefix)
model KonsultaDiagnosticResult {
  id                   String   @id @default(uuid())
  consultationTicketId Int? // NULL for profiling results (Tagging 1)
  clinicPatientId      Int
  clinicId             Int
  hciCaseNo            String // T-prefix case number (FK to Enlistment)
  hciTransNo           String // P-prefix (profiling) or S-prefix (consultation)
  resultType           String // "FBS", "CBC", "URINALYSIS", "CHESTXRAY", "ECG", etc.
  resultData           Json // Structured result values per type
  transDate            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  ConsultationTicket ConsultationTicket? @relation(fields: [consultationTicketId], references: [id], onDelete: Cascade)
  ClinicPatient      ClinicPatient       @relation(fields: [clinicPatientId], references: [id], onDelete: Cascade)
  Clinic             Clinic              @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@index([hciCaseNo])
  @@index([consultationTicketId])
}

// ─────────────────────────────────────────────────────────────────────────────
// PhilHealth Konsulta Management
// ─────────────────────────────────────────────────────────────────────────────

/// Reference table: official PhilHealth management codes.
/// Seeded with: 0=Not applicable, 1=Breastfeeding, 2=Smoking Cessation,
/// 3=Lifestyle Modification, 4=Oral Check-up, X=Others
model KonsultaManagementCode {
  id          String @id @default(uuid())
  code        String @unique // PhilHealth code value: "0","1","2","3","4","X"
  description String
  sortOrder   Int    @default(0)

  ConsultationManagements ConsultationManagement[]
}

/// Reference table: official PhilHealth signs & symptoms codes.
model KonsultaSignAndSymptom {
  id          String   @id @default(uuid())
  code        String   @unique // PhilHealth code value: "01", "02", etc., and "X"
  description String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Per-consultation management entries (many per ticket).
model ConsultationManagement {
  id                   String   @id @default(uuid())
  consultationTicketId Int
  managementCodeId     String // FK -> KonsultaManagementCode.id
  remarks              String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  ConsultationTicket ConsultationTicket     @relation(fields: [consultationTicketId], references: [id], onDelete: Cascade)
  ManagementCode     KonsultaManagementCode @relation(fields: [managementCodeId], references: [id])

  @@index([consultationTicketId])
}

model PhysicalExamLibrary {
  id            String  @id @default(uuid())
  category      String // e.g., "CHEST", "HEENT", "SKIN", "HEART", "ABDOMEN", "GU", "NEURO", "RECTAL"
  code          String // The ID from the screenshot (e.g., "1", "2", "99")
  description   String // The label (e.g., "Essentially normal")
  libraryStatus Int     @default(1) // 1 = ACTIVE, 0 = DEACTIVATED
  isActive      Boolean @default(true)

  @@unique([category, code])
}

model PhysicalExamination {
  id                   String   @id @default(uuid())
  userId               Int
  consultationTicketId Int? // Nullable FK to ConsultationTicket
  dateTaken            DateTime @default(now())

  // Storing the single String ID from PhilHealth's Library of Values
  generalSurveyId      String? // pGenSurveyId (e.g. "1" or "2")
  generalSurveyRemarks String? // pGenSurveyRem

  heentId      String? // pHeentId
  heentRemarks String? // pHeentRem

  chestId      String? // pChestId
  chestRemarks String? // pChestRem

  heartId      String? // pHeartId
  heartRemarks String? // pHeartRem

  abdomenId      String? // pAbdomenId
  abdomenRemarks String? // pAbdomenRem

  guId      String? // pGuId
  guRemarks String? // pGuRem

  skinId      String? // pSkinId
  skinRemarks String? // pSkinRem

  neuroId      String? // pNeuroId
  neuroRemarks String? // pNeuroRem

  rectalId      String? // pRectalId
  rectalRemarks String? // pRectalRem

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  User               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ConsultationTicket ConsultationTicket? @relation(fields: [consultationTicketId], references: [id], onDelete: SetNull)
}

