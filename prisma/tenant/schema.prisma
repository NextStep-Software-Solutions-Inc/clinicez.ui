generator client {
  provider      = "prisma-client-js"
  output        = "../../node_modules/@prisma/tenant/client"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("TENANT_DATABASE_URL")
  directUrl = env("TENANT_DATABASE_URL_UNPOOLED")
}

model Appointment {
  id                     Int                     @id @default(autoincrement())
  orgUid                 String
  subject                String
  complaint              String?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  deletedAt              DateTime?
  Requesters             AppointmentRequester[]
  AppointmentAttribute   AppointmentAttribute?
  AppointmentRouting     AppointmentRouting[]
  AppointmentAttachments AppointmentAttachment[]
  PreConsultationNotes   PreConsultationNote[]
  ConsultationRecords    ConsultationRecord[]
}

model AppointmentAttachment {
  id            Int         @id @default(autoincrement())
  appointmentId Int
  name          String
  url           String
  Appointment   Appointment @relation(fields: [appointmentId], references: [id])
}

model AppointmentRequester {
  id            Int         @id @default(autoincrement())
  appointmentId Int
  email         String
  Appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([appointmentId, email], name: "unique_appointment_email")
}

model AppointmentAttribute {
  id                 Int             @id @default(autoincrement())
  appointmentId      Int             @unique
  recurring          Boolean         @default(false)
  maxDuration        Int             @default(30)
  date               DateTime?       @db.Date
  timeStart          DateTime?       @db.Time
  timeEnd            DateTime?       @db.Time
  modeId             Int
  typeId             Int
  receivedAt         DateTime?
  receivedBy         String?
  rejectedAt         DateTime?
  rejectedBy         String?
  rejectedReason     String?
  completedAt        DateTime?
  completedBy        String?
  status             String          @default("PENDING")
  serviceId          Int?
  preferredAppointee String?
  Appointment        Appointment     @relation(fields: [appointmentId], references: [id])
  AppointmentMode    AppointmentMode @relation(fields: [modeId], references: [id])
  AppointmentType    AppointmentType @relation(fields: [typeId], references: [id])
  Service            Service?        @relation(fields: [serviceId], references: [id])
}

model AppointmentType {
  id                       Int                       @id @default(autoincrement())
  orgUid                   String
  name                     String
  description              String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  isActive                 Boolean                   @default(true)
  AppointmentAttributes    AppointmentAttribute[]
  AppointmentTypeAttribute AppointmentTypeAttribute?
}

model AppointmentTypeAttribute {
  id                Int             @id @default(autoincrement())
  appointmentTypeId Int             @unique
  requirments       String[]        @default([])
  reminders         String[]        @default([])
  duration          Int             @default(30)
  durationPadding   Int             @default(0)
  specializations   String[]        @default([])
  resources         String[]        @default([])
  AppointmentType   AppointmentType @relation(fields: [appointmentTypeId], references: [id])
}

model AppointmentMode {
  id                    Int                    @id @default(autoincrement())
  orgUid                String
  name                  String
  description           String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?
  isActive              Boolean                @default(true)
  AppointmentAttributes AppointmentAttribute[]
}

model AppointmentRouting {
  id            Int         @id @default(autoincrement())
  routingCode   String      @unique @default(cuid())
  appointmentId Int
  routedBy      String
  routedTo      String
  routedToRole  String      @default("")
  status        String      @default("PENDING")
  amendment     String?
  amendedAt     DateTime?
  amendedBy     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  Appointment   Appointment @relation(fields: [appointmentId], references: [id])

  @@unique([appointmentId, routedTo], name: "unique_appointment_routing")
}

model ServiceCategory {
  id          Int       @id @default(autoincrement())
  orgUid      String
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  Services    Service[]
}

model Service {
  id                   Int                    @id @default(autoincrement())
  name                 String
  description          String?
  categoryId           Int
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  isActive             Boolean                @default(true)
  ServiceCategory      ServiceCategory        @relation(fields: [categoryId], references: [id])
  AppointmentAttribute AppointmentAttribute[]
  ServiceAttribute     ServiceAttribute?
}

model ServiceAttribute {
  id              Int      @id @default(autoincrement())
  serviceId       Int      @unique
  requirments     String[] @default([])
  reminders       String[] @default([])
  duration        Int      @default(30)
  durationPadding Int      @default(0)
  specializations String[] @default([])
  resources       String[] @default([])
  Service         Service  @relation(fields: [serviceId], references: [id])
}

model ConsultationRecord {
  id                          Int                          @id @default(autoincrement())
  appointmentId               Int
  orgUid                      String
  subject                     String
  createdBy                   String
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  isActive                    Boolean                      @default(true)
  Appointment                 Appointment                  @relation(fields: [appointmentId], references: [id])
  NoteContents                NoteContent[]
  ConsultationRecordAttribute ConsultationRecordAttribute?
  Interventions               Intervention[]
}

model ConsultationRecordAttribute {
  id                   Int                @id @default(autoincrement())
  consultationRecordId Int                @unique
  template             String             @default("SOAP")
  whitelistEmails      String[]           @default([])
  ConsultationRecord   ConsultationRecord @relation(fields: [consultationRecordId], references: [id])
}

model NoteContent {
  id                   Int                 @id @default(autoincrement())
  consultationRecordId Int?
  section              String
  content              String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  ConsultationRecord   ConsultationRecord? @relation(fields: [consultationRecordId], references: [id])

  @@unique([consultationRecordId, section], name: "unique_consultation_record_section")
}

model PreConsultationNote {
  id                           Int                           @id @default(autoincrement())
  appointmentId                Int
  orgUid                       String
  assessment                   String
  homeInstructions             String?
  remarks                      String
  createdBy                    String
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  Appointment                  Appointment                   @relation(fields: [appointmentId], references: [id])
  PreConsultationNoteAttribute PreConsultationNoteAttribute?

  @@unique([appointmentId, createdBy], name: "unique_appointment_created_by")
}

model PreConsultationNoteAttribute {
  id                    Int                 @id @default(autoincrement())
  preConsultationNoteId Int                 @unique
  whitelistEmails       String[]            @default([])
  PreConsultationNote   PreConsultationNote @relation(fields: [preConsultationNoteId], references: [id])
}

model Intervention {
  id                   Int                @id @default(autoincrement())
  orgUid               String
  hpId                 Int
  consultationRecordId Int
  actionId             Int
  details              String
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  deletedAt            DateTime?
  isActive             Boolean            @default(true)
  ConsultationRecord   ConsultationRecord @relation(fields: [consultationRecordId], references: [id])
  Action               Action             @relation(fields: [actionId], references: [id])
}

model Action {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  isActive      Boolean        @default(true)
  Interventions Intervention[]
}
